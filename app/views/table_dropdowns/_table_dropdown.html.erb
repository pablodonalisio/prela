<%= turbo_frame_tag table_dropdown do %>
  <div class="rounded-xl border border-default bg-neutral-primary p-4">
    <div class="flex flex-col items-start gap-3 md:flex-row md:items-center">
      <div class="min-w-0 flex-1">
        <h5 class="mb-1 font-semibold text-heading"><%= table_dropdown.name %></h5>

        <div class="flex flex-wrap gap-2">
          <% table_dropdown.table_dropdown_values.each do |value| %>
            <span class="inline-flex items-center rounded-full bg-brand-soft px-2.5 py-0.5 text-xs font-medium text-fg-brand">
              <%= value.label %>
            </span>
          <% end %>
        </div>
      </div>

      <% if current_user.admin? %>
        <div class="shrink-0 self-end md:self-center">
          <%= render "shared/dropdown" do %>
            <%= render "shared/button_box",
                       edit_path: edit_table_dropdown_path(table_dropdown),
                       delete_path: table_dropdown_path(table_dropdown),
                       confirm: "¿Seguro que querés borrar este valor desplegable?" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
