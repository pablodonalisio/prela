<%= form_with url: new_location_equipment_path, method: :get, local: true, data: { turbo: true} do |f| %>
  <% if flash.now[:alert] %>
    <div class="alert alert-danger" role="alert">
      <%= flash.now[:alert] %>
    </div>
  <% end %>
  <%= f.hidden_field :step, value: 2%>
  <%= f.label :client_id, "Cliente" %>
  <%= f.select :client_id, Client.pluck(:name, :id), { prompt: "Seleccione un cliente" }, { class: "form-control mt-2" } %>
  <%= f.submit "Siguiente", class: "btn btn-primary mt-3", data: { keep_modal_open: true } %>
<% end %>