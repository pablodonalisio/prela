<div class="mb-4">
  <h6 class="mb-2 text-sm font-semibold text-heading"><%= title %></h6>
  <%= f.collection_check_boxes attribute, collection, value, label do |b| %>
    <div class="mb-2 flex items-center">
      <%= b.check_box checked: selected_filters&.include?(b.value.to_s),
                      class: "h-4 w-4 rounded border-default bg-neutral-secondary-soft text-brand focus:ring-brand",
                      onchange: "this.form.requestSubmit()"  %>
      <%= b.label(class: "ms-2 text-sm text-heading") %>
    </div>
  <% end %>
</div>
