<%= turbo_frame_tag "", class: "location_equipment_filters" do %>
  <%= form_with(url: url_for, method: :get, data: { turbo_stream: true }) do |f| %>
    <%= f.label :order, "Ordenar por", class: "mb-2 block text-sm font-medium text-heading" %>
    <%= f.select :order,
                 [["Código", "code"], ["Sala", "zone"]],
                 {selected: order, prompt: "Ordenar por"},
                 {onchange: "this.form.requestSubmit()",
                  class: "mb-4 block w-full rounded-lg border border-default bg-neutral-secondary-soft p-2.5 text-sm text-heading focus:border-brand focus:ring-brand"} %>

    <%= render "filter_item", title: "Clientes Con Abono",
                              f: f,
                              attribute: :client_ids,
                              collection: policy_scope(Client).with_subscription.order(:name),
                              value: :id,
                              label: :name,
                              selected_filters: filter_params[:client_ids] %>

    <%= render "filter_item", title: "Clientes Sin Abono",
                              f: f,
                              attribute: :client_ids,
                              collection: policy_scope(Client).without_subscription.order(:name),
                              value: :id,
                              label: :name,
                              selected_filters: filter_params[:client_ids] %>

    <% if filter_params[:client_ids].present? &&
          (locations = Location.visible.where(client_id: filter_params[:client_ids])).present? %>
      <%= render "filter_item", title: "Sede",
                                f: f,
                                attribute: :location_ids,
                                collection: locations,
                                value: :id,
                                label: :name,
                                selected_filters: filter_params[:location_ids] %>
    <% end %>

    <% if current_user.admin? %>
      <%= render "filter_item", title: "Estado",
                                f: f,
                                attribute: :status,
                                collection: LocationEquipment.enum_attributes_for_select("status"),
                                value: :last,
                                label: :first,
                                selected_filters: filter_params[:status] %>
    <% end %>

    <%= render "filter_item", title: "Tipo",
                              f: f,
                              attribute: :equipment_kind_ids,
                              collection: EquipmentKind.visible.order(:name),
                              value: :id,
                              label: :name,
                              selected_filters: filter_params[:equipment_kind_ids] %>

    <% if Tag.visible.any? %>
      <%= render "filter_item", title: "Etiquetas",
                                f: f,
                                attribute: :tag_ids,
                                collection: Tag.visible.order(:name),
                                value: :id,
                                label: :name,
                                selected_filters: filter_params[:tag_ids] %>
    <% end %>

  <% end %>
<% end %>
