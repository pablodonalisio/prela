<div class="mb-2">
  <p class="mb-0 truncate text-sm text-body">
    <%= item.client.name %> - <%= item.location.name %>
  </p>
  <p class="m-0 truncate text-sm text-body-subtle">
    Sala: <%= item.zone %>
  </p>
  <p class="m-0 truncate text-sm text-body-subtle">
    Piso: <%= humanize_floor(item.floor) %>
  </p>
  <p class="m-0 truncate text-sm text-body-subtle">
    Estado: <%= item.status ? t("activerecord.attributes.location_equipment.statuses.#{item.status}") : "" %>
  </p>
  <p class="m-0 truncate text-sm text-body-subtle">
    Código: <%= item.code %>
  </p>
</div>
<div class="mb-2 h-[72px]">
  <% item.open_service_occurrences.each do |service_occurrence| %>
    <p class="m-0 truncate text-sm">
      <span class="text-body-subtle"><%= service_occurrence.service_kind.name %>: </span>
      <span class="<%= service_date_color(service_occurrence.due_on) %>">
        <%= service_occurrence.due_on.strftime("%d/%m/%Y") %>
      </span>
    </p>
  <% end %>
</div>
