<div class="mb-2">
  <p class="card-text text-truncate mb-0">
    <small>
      <%= item.client.name %> - <%= item.location.name %>
    </small>
  </p>
  <p class="card-text text-truncate m-0">
    <small class="text-body-secondary">
      Sala: <%= item.zone %>
    </small>
  </p>
  <p class="card-text text-truncate m-0">
    <small class="text-body-secondary">
      Piso: <%= humanize_floor(item.floor) %>
    </small>
  </p>
  <p class="card-text text-truncate m-0">
    <small class="text-body-secondary">
      Estado: <%= item.status ? t("activerecord.attributes.location_equipment.statuses.#{item.status}") : "" %>
    </small>
  </p>
  <p class="card-text text-truncate m-0">
    <small class="text-body-secondary">
      Código: <%= item.code %>
    </small>
  </p>
</div>
<div class="mb-2" style="height: 72px">
  <% item.open_service_occurrences.each do |service_occurrence| %>
    <p class="card-text m-0 text-truncate">
      <small class="text-body-secondary">
        <label><%= service_occurrence.service_kind.name %>: </label>
        <span class="<%= service_date_color(service_occurrence.due_on) %>">
          <%= service_occurrence.due_on.strftime("%d/%m/%Y") %>
        </span>
      </small>
    </p>
  <% end %>
</div>
