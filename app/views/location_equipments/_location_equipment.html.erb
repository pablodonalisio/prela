<%= turbo_frame_tag location_equipment do %>
  <div class="card bg-secondary mt-3">
    <%# ── Header: image + title + actions ───────────────── %>
    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center gap-3 p-3">
      <div class="flex-shrink-0" style="width: 120px; height: 120px;">
        <%= image_tag image_for(location_equipment, :avatar, ""),
                      alt: "Imagen de Item",
                      class: "rounded w-100 h-100 object-fit-cover" %>
      </div>
      <div class="flex-grow-1 min-w-0">
        <% if current_user.admin? %>
          <h5 class="mb-0">
            <%= link_to location_equipment.equipment.name,
                        equipment_path(location_equipment.equipment),
                        class: "text-white text-decoration-none",
                        data: { turbo_frame: "_top" } %>
          </h5>
        <% else %>
          <h5 class="mb-0"><%= location_equipment.equipment.name %></h5>
        <% end %>
        <p class="text-white-50 small mb-1">
          <%= location_equipment.location.client.name %> · <%= location_equipment.location.name %>
        </p>
        <span class="badge bg-<%= location_equipment.condition_color %> rounded-pill">
          Condición: <%= location_equipment.condition %>
        </span>
      </div>
      <% if current_user.admin? %>
        <div class="flex-shrink-0">
          <%= render "shared/dropdown" do %>
            <%= render "shared/button_box", edit_path: edit_location_equipment_path(location_equipment),
                                            delete_path: location_equipment_path(location_equipment),
                                            confirm: "Seguro queres borrar este equipo?" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# ── Data columns ────────────────────────────────────── %>
    <div class="row g-0 border-top border-white border-opacity-10 px-3 pb-3">
      <div class="col-12 col-md-4 pt-3 pe-md-3">
        <%= render "details", location_equipment: location_equipment %>
      </div>
      <div class="col-12 col-md-4 pt-3 px-md-3 border-md-start border-white border-opacity-10">
        <%= render "field_values", location_equipment: location_equipment %>
      </div>
      <div class="col-12 col-md-4 pt-3 ps-md-3 border-md-start border-white border-opacity-10">
        <%= render "service_dates", location_equipment: location_equipment %>
      </div>
    </div>

      <div class="col-12 p-3">
        <div class="row gx-5">

          <% unless location_equipment.equipment.building? %>
            <div class="col-12 col-md-6 col-xxl-3">
              <div class="col">
                <%= render "shared/content_header", title: "Informes" do %>
                  <% if current_user.admin? || current_user.editor? %>
                    <%= render "shared/button_link", icon: "fa-solid fa-plus",
                                                     text: "",
                                                    path: new_location_equipment_report_path(@location_equipment) %>
                  <% end %>
                <% end %>
                <%= render "reports/reports", reports: @location_equipment.reports.order(date: :desc), location_equipment: @location_equipment %>
              </div>
            </div>
          <% end %>

          <div class="col-12 col-md-6 col-xxl-3">
            <div class="col">
              <%= render "shared/content_header", title: "Fallas" do %>
                <% if current_user.admin? %>
                  <%= render "shared/button_link", icon: "fa-solid fa-plus",
                                                   text: "",
                                                   path: new_location_equipment_failure_path(@location_equipment) %>
                <% end %>
              <% end %>
              <%= render "failures/failures", failures: @location_equipment.failures.order(date: :desc), location_equipment: @location_equipment %>
            </div>
          </div>

          <div class="col-12 col-md-6 col-xxl-3">
            <div class="col">
              <%= render "shared/content_header", title: "Actividades" do %>
                <% if current_user.admin? || current_user.editor? %>
                  <%= render "shared/button_link", icon: "fa-solid fa-plus",
                                                   text: "",
                                                   path: new_location_equipment_activity_path(@location_equipment) %>
                <% end %>
              <% end %>
              <%= render "activities/activities", activities: @location_equipment.activities.order(date: :desc), location_equipment: @location_equipment %>
            </div>
          </div>

          <div class="col-12 col-md-6 col-xxl-3">
            <div class="col">
              <%= render "shared/content_header", title: "Documentos" do %>
                <% if current_user.admin? %>
                  <%= render "shared/button_link", icon: "fa-solid fa-plus",
                                                   text: "",
                                                   path: new_location_equipment_document_path(@location_equipment, document: {documentable_type: @location_equipment.class.name, documentable_id: @location_equipment.id}) %>
                <% end %>
              <% end %>
              <%= render "documents/documents", documents: @location_equipment.documents.order(created_at: :desc), documentable: @location_equipment %>
            </div>
          </div>

          <% if current_user.admin? %>
            <div class="col-12">
              <%= render "shared/content_header", title: "Insumos" %>
              <div class="row">
                <div class="w-auto">
                  <h5 class="text-center">Bateria</h5>
                  <%= turbo_frame_tag "equipment_battery" do %>
                    <%= render "equipment_supplies/equipment_battery", equipment: location_equipment %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>