<%= turbo_frame_tag location_equipment do %>
  <div class="mx-4 mb-8 mt-4 space-y-4 md:mx-6">
    <div class="flex flex-col gap-4 rounded-xl border border-default bg-neutral-primary p-5 md:flex-row md:items-center">
      <div class="h-[120px] w-[120px] shrink-0">
        <%= image_tag image_for(location_equipment, :display_avatar, ""),
                      alt: "Imagen de Item",
                      class: "h-full w-full rounded-xl object-cover" %>
      </div>
      <div class="min-w-0 flex-1">
        <% if current_user.admin? %>
          <h2 class="text-xl font-bold text-heading">
            <%= link_to location_equipment.equipment.name,
                        equipment_path(location_equipment.equipment),
                        class: "hover:text-fg-brand hover:underline",
                        data: {turbo_frame: "_top"} %>
          </h2>
        <% else %>
          <h2 class="text-xl font-bold text-heading"><%= location_equipment.equipment.name %></h2>
        <% end %>
        <p class="mt-1 text-sm text-body-subtle">
          <%= location_equipment.location.client.name %> · <%= location_equipment.location.name %>
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-1.5">
          <span class="rounded-full px-2.5 py-0.5 text-xs font-medium <%= condition_badge_classes(location_equipment.condition_color) %>">
            Condición: <%= location_equipment.condition %>
          </span>
          <% location_equipment.tags.kept.order(:name).each do |tag| %>
            <%= render "tags/badge", tag: tag %>
          <% end %>
        </div>
      </div>
      <% if current_user.admin? %>
        <div class="shrink-0">
          <%= render "shared/dropdown" do %>
            <%= render "shared/button_box", edit_path: edit_location_equipment_path(location_equipment),
                                                     delete_path: location_equipment_path(location_equipment),
                                                     confirm: "Seguro queres borrar este equipo?" %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="grid gap-4 rounded-xl border border-default bg-neutral-primary p-5 md:grid-cols-2">
      <div>
        <%= render "details", location_equipment: location_equipment %>
      </div>
      <div class="md:border-l md:border-default md:pl-5">
        <%= render "field_values", location_equipment: location_equipment %>
      </div>
    </div>

    <% tab_prefix = dom_id(location_equipment, :tab) %>
    <div class="rounded-xl border border-default bg-neutral-primary p-5">
      <div class="border-b border-default">
        <ul class="-mb-px flex flex-wrap gap-1 text-sm font-medium" id="<%= tab_prefix %>-tabs" data-tabs-toggle="#<%= tab_prefix %>-content" role="tablist">
          <% [
            ["informes", "Informes", true],
            ["servicios", "Servicios", false],
            ["fallas", "Fallas", false],
            ["actividades", "Actividades", false],
            ["documentos", "Documentos", false],
            ["comentarios", "Comentarios", false]
          ].each do |key, label, selected| %>
            <li role="presentation">
              <button class="inline-block border-b-2 px-4 py-3" id="<%= tab_prefix %>-<%= key %>-tab"
                      data-tabs-target="#<%= tab_prefix %>-<%= key %>" type="button" role="tab"
                      aria-controls="<%= tab_prefix %>-<%= key %>" aria-selected="<%= selected %>"><%= label %></button>
            </li>
          <% end %>
          <% if current_user.admin? %>
            <li role="presentation">
              <button class="inline-block border-b-2 px-4 py-3" id="<%= tab_prefix %>-insumos-tab"
                      data-tabs-target="#<%= tab_prefix %>-insumos" type="button" role="tab"
                      aria-controls="<%= tab_prefix %>-insumos" aria-selected="false">Insumos</button>
            </li>
          <% end %>
        </ul>
      </div>

      <div id="<%= tab_prefix %>-content" class="pt-4">
        <div id="<%= tab_prefix %>-informes" role="tabpanel" aria-labelledby="<%= tab_prefix %>-informes-tab">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-heading">Informes</h3>
            <% if current_user.admin? || current_user.editor? %>
              <%= render "shared/button_link", icon: :add,
                                               text: "",
                                               path: new_location_equipment_report_path(location_equipment) %>
            <% end %>
          </div>
          <%= render "reports/reports",
                     reports: location_equipment.reports.order(date: :desc),
                     location_equipment: location_equipment %>
        </div>

        <div class="hidden" id="<%= tab_prefix %>-servicios" role="tabpanel" aria-labelledby="<%= tab_prefix %>-servicios-tab">
          <%= render "location_equipment_services/list", location_equipment: location_equipment %>
          <%= render "service_occurrences", location_equipment: location_equipment %>
        </div>

        <div class="hidden" id="<%= tab_prefix %>-fallas" role="tabpanel" aria-labelledby="<%= tab_prefix %>-fallas-tab">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-heading">Fallas</h3>
            <% if current_user.admin? %>
              <%= render "shared/button_link", icon: :add,
                                               text: "",
                                               path: new_location_equipment_failure_path(location_equipment) %>
            <% end %>
          </div>
          <%= render "failure_metrics", location_equipment: location_equipment %>
          <%= render "failures/failures",
                     failures: location_equipment.failures.order(date: :desc),
                     location_equipment: location_equipment %>
        </div>

        <div class="hidden" id="<%= tab_prefix %>-actividades" role="tabpanel" aria-labelledby="<%= tab_prefix %>-actividades-tab">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-heading">Actividades</h3>
            <% if current_user.admin? || current_user.editor? %>
              <%= render "shared/button_link", icon: :add,
                                               text: "",
                                               path: new_location_equipment_activity_path(location_equipment) %>
            <% end %>
          </div>
          <%= render "activities/activities",
                     activities: location_equipment.activities.order(date: :desc),
                     location_equipment: location_equipment %>
        </div>

        <div class="hidden" id="<%= tab_prefix %>-documentos" role="tabpanel" aria-labelledby="<%= tab_prefix %>-documentos-tab">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-heading">Documentos</h3>
            <% if current_user.admin? %>
              <%= render "shared/button_link",
                         icon: :add,
                         text: "",
                         path: new_location_equipment_document_path(
                           location_equipment,
                           document: {
                             documentable_type: location_equipment.class.name,
                             documentable_id: location_equipment.id
                           }
                         ) %>
            <% end %>
          </div>
          <%= render "documents/documents",
                     documents: policy_scope(location_equipment.documents).order(created_at: :desc),
                     documentable: location_equipment %>
        </div>

        <div class="hidden" id="<%= tab_prefix %>-comentarios" role="tabpanel" aria-labelledby="<%= tab_prefix %>-comentarios-tab">
          <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-heading">Comentarios</h3>
            <% if current_user.admin? %>
              <%= render "shared/button_link", icon: :add,
                                               text: "",
                                               path: new_location_equipment_comment_path(location_equipment) %>
            <% end %>
          </div>
          <%= render "comments/comments",
                     comments: location_equipment.comments.order(updated_at: :desc),
                     location_equipment: location_equipment %>
        </div>

        <% if current_user.admin? %>
          <div class="hidden" id="<%= tab_prefix %>-insumos" role="tabpanel" aria-labelledby="<%= tab_prefix %>-insumos-tab">
            <h3 class="mb-3 text-sm font-semibold uppercase tracking-wide text-heading">Insumos</h3>
            <div class="w-auto">
              <h5 class="mb-2 text-center text-base font-semibold text-heading">Bateria</h5>
              <%= turbo_frame_tag "equipment_battery" do %>
                <%= render "equipment_supplies/equipment_battery", equipment: location_equipment %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
