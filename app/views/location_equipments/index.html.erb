<%= turbo_frame_tag "main_content" do %>
  <%= render "shared/section_nav", active: "location_equipments" %>

  <% if current_user.admin? %>
    <%= render "shared/content_header", title: "Lista" do %>
      <%= render "shared/button_link", text: "Agregar", path: new_location_equipment_path %>
    <% end %>
  <% end %>

  <div id="location_equipments_list">
    <%= render "shared/items", collection: @location_equipments, pagy: @pagy %>
  </div>
<% end %>
