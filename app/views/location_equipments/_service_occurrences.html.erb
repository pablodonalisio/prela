<%= turbo_frame_tag "service_occurrences" do %>
  <p class="text-white small text-uppercase fw-semibold mb-1 mt-2">Servicios</p>
  <% occurrences = location_equipment.service_occurrences
       .includes(location_equipment_service: :service_kind)
       .order(Arel.sql("COALESCE(service_occurrences.completed_on, service_occurrences.planned_on, service_occurrences.due_on) DESC")) %>
  <% if occurrences.any? %>
    <div style="max-height: 400px; overflow-y: auto;" class="my-2">
      <table class="table mb-0 align-middle">
        <thead style="position: sticky; z-index: 100; top: 0">
          <tr>
            <th>Fecha</th>
            <th>Tipo</th>
            <th>Estado</th>
            <th>Notas</th>
            <th></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% occurrences.each do |occurrence| %>
            <tr id="<%= dom_id(occurrence, :row) %>">
              <td>
                <span class="<%= occurrence.open? ? service_date_color(occurrence.due_on) : nil %>">
                  <%= occurrence.service_date.strftime("%d/%m/%Y") %>
                </span>
              </td>
              <td><%= occurrence.service_kind.name %></td>
              <td>
                <% if occurrence.completed? %>
                  <span class="badge bg-success rounded-pill"><%= occurrence.status_label %></span>
                <% elsif occurrence.scheduled? %>
                  <span class="badge bg-info text-dark rounded-pill"><%= occurrence.status_label %></span>
                <% elsif occurrence.suspended? %>
                  <span class="badge bg-secondary rounded-pill"><%= occurrence.status_label %></span>
                <% elsif occurrence.cancelled? %>
                  <span class="badge bg-secondary rounded-pill"><%= occurrence.status_label %></span>
                <% else %>
                  <span class="badge bg-warning rounded-pill"><%= occurrence.status_label %></span>
                <% end %>
              </td>
              <td class="text-body-secondary small"><%= occurrence.notes.presence || "—" %></td>
              <td class="text-nowrap">
                <% if occurrence.document.attached? %>
                  <%= link_to rails_blob_path(occurrence.document, disposition: "inline"),
                              target: "_blank",
                              rel: "noopener",
                              title: "Ver documento",
                              data: {turbo: false} do %>
                    <i class="fa fa-file" aria-hidden="true"></i>
                  <% end %>
                <% else %>
                  <span class="text-white-50">—</span>
                <% end %>
              </td>
              <td class="text-nowrap">
                <%= render "service_occurrences/actions", service_occurrence: occurrence, class: "me-2" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-white-50 small mb-0">Sin servicios</p>
  <% end %>
<% end %>
