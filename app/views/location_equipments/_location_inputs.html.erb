<%= turbo_frame_tag "le_location_inputs" do %>
  <% if @locations.any? %>
    <div class="mb-3">
      <label class="mb-2 block text-sm font-medium text-heading">Sede</label>
      <select class="block w-full rounded-lg border border-default bg-neutral-secondary-medium p-2.5 text-sm text-heading focus:border-brand focus:ring-brand"
              name="location_equipment[location_id]"
              id="location_equipment_location_id">
        <option value="">Seleccione una sede</option>
        <% @locations.each do |location| %>
          <option value="<%= location.id %>"
                  <%= "selected" if @selected_location_id == location.id.to_s %>>
            <%= location.name %>
          </option>
        <% end %>
      </select>
    </div>
  <% elsif @client %>
    <p class="mb-3 text-sm text-body-subtle">Este cliente no tiene sedes registradas.</p>
  <% end %>
<% end %>
