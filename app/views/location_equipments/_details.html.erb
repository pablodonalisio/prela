<p class="text-white small text-uppercase fw-semibold mb-1 mt-2">Ubicación</p>
<dl class="row row-cols-2 g-0 mb-0 small">
  <dt class="col text-body-secondary fw-normal">Sala</dt>
  <dd class="col mb-1"><%= location_equipment.zone.presence || "—" %></dd>

  <dt class="col text-body-secondary fw-normal">Piso</dt>
  <dd class="col mb-1"><%= humanize_floor(location_equipment.floor) %></dd>

  <dt class="col text-body-secondary fw-normal">Código</dt>
  <dd class="col mb-1"><%= location_equipment.code.presence || "—" %></dd>

  <dt class="col text-body-secondary fw-normal">Estado</dt>
  <dd class="col mb-1">
    <%= location_equipment.status ? t("activerecord.attributes.location_equipment.statuses.#{location_equipment.status}") : "—" %>
  </dd>
</dl>
