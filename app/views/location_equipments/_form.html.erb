<%= simple_form_for location_equipment,
      html: { data: { controller: "location-equipment-form" }} do |f| %>

  <%# ── Location ─────────────────────────────────────────── %>
  <div class="card mb-3 border-0 shadow-sm">
    <div class="card-header fw-semibold text-white small text-uppercase">
      <i class="fa fa-map-marker-alt me-2 text-primary"></i>Locación
    </div>
    <div class="card-body pb-1">

      <% selected_client_id = params[:client_id].presence || location_equipment.location&.client_id %>
      <div class="mb-3">
        <label class="form-label">Cliente</label>
        <select name="client_id"
                class="form-select"
                data-location-equipment-form-target="client"
                data-action="change->location-equipment-form#loadLocations">
          <option value="">Seleccione un cliente</option>
          <% Client.visible.order(:name).each do |client| %>
            <option value="<%= client.id %>" <%= "selected" if selected_client_id.to_s == client.id.to_s %>>
              <%= client.name %>
            </option>
          <% end %>
        </select>
      </div>

      <%= turbo_frame_tag "le_location_inputs" do %>
        <% if selected_client_id.present? %>
          <% client_locations = Location.visible.where(client_id: selected_client_id).order(:name) %>
          <% if client_locations.any? %>
            <%= f.input :location_id, label: "Sede",
                                      collection: client_locations.pluck(:name, :id),
                                      prompt: "Seleccione una sede",
                                      wrapper_html: { class: "mb-3" } %>
          <% else %>
            <p class="text-muted small mb-3">Este cliente no tiene sedes registradas.</p>
          <% end %>
        <% end %>
      <% end %>

      <div class="row g-3">
        <div class="col-sm-6">
          <%= f.input :zone, label: "Sala", wrapper_html: { class: "mb-3" } %>
        </div>
        <div class="col-sm-6">
          <%= f.input :floor, label: "Piso", wrapper_html: { class: "mb-3" } %>
        </div>
      </div>
    </div>
  </div>

  <%# ── Equipment ───────────────────────────────────────── %>
  <div class="card mb-3 border-0 shadow-sm">
    <div class="card-header fw-semibold text-white small text-uppercase">
      <i class="fa fa-plug me-2 text-primary"></i>Equipo
    </div>
    <div class="card-body pb-1">
      <%= f.input :equipment_id, label: "Equipo",
                                 collection: Equipment.visible.map { |e| [e.name, e.id] },
                                 prompt: "Seleccione un equipo",
                                 wrapper_html: { class: "mb-3" },
                                 input_html: { data: { controller: "searchable-select",
                                                       location_equipment_form_target: "equipment",
                                                       action: "change->location-equipment-form#displayInputsForEquipmentKind"}} %>
      <p class="small text-white mt-n2 mb-3">
        ¿No encontrás el equipo?
        <%= link_to "Crear uno nuevo", new_equipment_path, class: "text-primary" %>.
      </p>

      <%= f.input :avatar, label: "Foto",
                           hint: "Opcional. Si no se adjunta, se usa la foto del equipo.",
                           wrapper_html: { class: "mb-3" } %>

      <div class="row g-3">
        <div class="col-sm-6">
          <%= f.input :serial_number, wrapper_html: { class: "mb-3" } %>
        </div>
        <div class="col-sm-6">
          <%= f.input :code, wrapper_html: { class: "mb-3" } %>
        </div>
      </div>

      <%= turbo_frame_tag "le_field_inputs",
            src: location_equipment.persisted? ?
              field_inputs_location_equipments_path(
                equipment_id: location_equipment.equipment_id,
                location_equipment_id: location_equipment.id
              ) : nil do %>
      <% end %>
    </div>
  </div>

      <div class="card mb-3 border-0 shadow-sm">
    <div class="card-header fw-semibold text-white small text-uppercase">
      <i class="fa fa-file-lines me-2 text-primary"></i>Plantillas de informe
    </div>
    <div class="card-body pb-1">
      <%= f.input :report_template_ids,
                  label: "Plantillas asociadas",
                  collection: ReportTemplate.order(:name).map { |t| [t.name, t.id] },
                  input_html: { multiple: true, class: "form-select" },
                  hint: "Opcional. Facilita la selección al crear informes con plantilla.",
                  wrapper_html: { class: "mb-3" } %>
    </div>
  </div>

  <%# ── Others ─────────────────────────────────────────── %>
  <div class="card mb-3 border-0 shadow-sm">
    <div class="card-header fw-semibold text-white small text-uppercase">
      <i class="fa fa-sliders-h me-2 text-primary"></i>Otros
    </div>
    <div class="card-body pb-1">
      <div class="row g-3">
        <div class="col-sm-6">
          <%= f.input :status, label: "Estado",
                               collection: LocationEquipment.enum_attributes_for_select("status"),
                               include_blank: false,
                               wrapper_html: { class: "mb-3" } %>
        </div>
        <div class="col-sm-6">
          <%= f.input :condition, label: "Condición",
                                  collection: LocationEquipment::CONDITIONS.keys,
                                  include_blank: false,
                                  wrapper_html: { class: "mb-3" } %>
        </div>
      </div>
      <%= f.input :tag_ids,
                  label: "Etiquetas",
                  collection: Tag.visible.order(:name).map { |t| [t.name, t.id] },
                  input_html: { multiple: true, class: "form-select" },
                  wrapper_html: { class: "mb-3" } %>
      <%= f.input :details, label: "Detalles", input_html: { rows: 3 }, wrapper_html: { class: "mb-3" } %>
    </div>
  </div>

  <div class="d-flex justify-content-end mt-4">
    <%= f.button :submit, "Aceptar", class: "btn btn-success px-4" %>
  </div>
<% end %>
