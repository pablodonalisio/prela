<%= turbo_frame_tag "main_content" do %>
  <%= render "shared/section_nav", active: "equipment_kinds" %>

  <%= render "shared/content_header", title: "Tipos de Activos" do %>
    <% if current_user.admin? %>
      <%= render "shared/button_link", text: "Agregar", path: new_equipment_kind_path %>
    <% end %>
  <% end %>

  <%= turbo_frame_tag "equipment_kinds", class: "mx-4 mt-4 flex flex-col gap-2 md:mx-6" do %>
    <% if @equipment_kinds.any? %>
      <%= render @equipment_kinds %>
    <% else %>
      <%= render "shared/empty_collection",
                 id: "equipment_kinds_empty",
                 message: "No hay tipos de activos todavía.",
                 action_text: current_user.admin? ? "Agregar" : nil,
                 action_path: current_user.admin? ? new_equipment_kind_path : nil %>
    <% end %>
  <% end %>
<% end %>
