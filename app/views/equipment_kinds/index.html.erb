<%= turbo_frame_tag "main_content" do %>
  <%= render "shared/section_nav", active: "equipment_kinds" %>

  <%= render "shared/content_header", title: "Tipos de Activos" do %>
    <% if current_user.admin? %>
      <%= render "shared/button_link", text: "Agregar", path: new_equipment_kind_path %>
    <% end %>
  <% end %>

  <div class="mx-4 mt-4 w-full max-w-xs md:mx-6">
    <%= render "filter_form" %>
  </div>

  <%= render "list" %>
<% end %>
