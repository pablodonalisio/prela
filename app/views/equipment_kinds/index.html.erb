<%= turbo_frame_tag "main_content", class: "w-100" do %>
  <%= render "location_equipments/navbar", active: "equipment_kinds" %>

  <% if current_user.admin? %>
    <div class="d-flex align-items-center flex-wrap m-4 gap-2">
      <%= render "shared/button_link", text: "Agregar",
                                      path: new_equipment_kind_path %>
    </div>
  <% end %>

  <%= turbo_frame_tag "equipment_kinds", class: "row m-4 g-3" do %>
      <%= render @equipment_kinds %>
  <% end %>

<% end %>
