<%= simple_form_for equipment_kind do |f| %>
  <%= f.input :name, label: "Nombre" %>
  <%= f.input :description, label: "Descripción", required: false, hint: "Opcional." %>

  <%= render "field_set_section",
             field_set: "generic_fields",
             label: "Campos genéricos",
             equipment_kind: equipment_kind %>

  <%= render "field_set_section",
             field_set: "specific_fields",
             label: "Campos específicos",
             equipment_kind: equipment_kind %>

  <div class="mb-3">
    <label class="form-label">Servicios</label>
    <%= f.collection_check_boxes :service_kind_ids,
                                 ServiceKind.visible.order(:name),
                                 :id,
                                 :name,
                                 include_hidden: true do |b| %>
      <div class="form-check">
        <%= b.check_box class: "form-check-input" %>
        <%= b.label class: "form-check-label" %>
      </div>
    <% end %>
  </div>

  <%= f.button :submit, "Aceptar", class: "btn btn-success" %>
<% end %>
