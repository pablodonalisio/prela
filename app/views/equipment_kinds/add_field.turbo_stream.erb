<% container_id = "fields-container-#{@field_set.dasherize}" %>
<% no_fields_id = "no-fields-message-#{@field_set.dasherize}" %>

<%= turbo_stream.append container_id do %>
  <%= render "equipment_kinds/equipment_kind_field",
             equipment_kind: @equipment_kind || EquipmentKind.new,
             field_set: @field_set,
             field_key: @field_key,
             field_data: {} %>
<% end %>
<%= turbo_stream.remove no_fields_id %>
