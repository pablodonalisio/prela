<% input_classes = "block w-full rounded-lg border border-default bg-neutral-secondary-soft p-2.5 text-sm text-heading" %>
<%= turbo_frame_tag "field_#{field_key}" do %>
  <div class="field-row mb-3 flex items-start gap-2">
    <div class="min-w-0 flex-1">
      <label class="mb-2 block text-sm font-medium text-heading">Nombre del campo</label>
      <input type="text"
             class="field-name <%= input_classes %> <%= 'border-red-500' if equipment_kind.errors.key?(field_set.to_sym) && field_data['name'].blank? %>"
             placeholder="ej: Marca, Modelo"
             value="<%= field_data['name'] %>"
             name="equipment_kind[<%= field_set %>][<%= field_key %>][name]">
      <% if equipment_kind.errors.key?(field_set.to_sym) && field_data["name"].blank? %>
        <div class="text-sm text-red-500">El nombre del campo no puede estar vacío.</div>
      <% end %>
    </div>
    <div class="min-w-0 flex-1">
      <label class="mb-2 block text-sm font-medium text-heading">Tipo de dato</label>
      <select class="field-type <%= input_classes %>" name="equipment_kind[<%= field_set %>][<%= field_key %>][type]">
        <% EquipmentKind::FIELD_TYPES.each do |type| %>
          <option value="<%= type %>" <%= "selected" if field_data["type"] == type %>>
            <%= t("activerecord.attributes.equipment_kind.field_types.#{type}") %>
          </option>
        <% end %>
      </select>
    </div>
    <div>
      <%= link_to "X",
                  remove_field_equipment_kinds_path(field_key: field_key),
                  class: "inline-flex items-center rounded-lg px-3 py-1.5 text-sm text-red-500 hover:bg-red-50 dark:hover:bg-red-900/40",
                  data: {
                    turbo_stream: true,
                    turbo_confirm: "¿Eliminar este campo? Se borrarán los valores guardados en todos los equipos/instalaciones de este tipo."
                  } %>
    </div>
  </div>
<% end %>
