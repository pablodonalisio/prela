<%= turbo_frame_tag "location_equipment_services" do %>
  <div class="d-flex align-items-center justify-content-between mb-1 mt-2">
    <p class="text-white small text-uppercase fw-semibold mb-0">Servicios programados</p>
    <% if policy(LocationEquipmentService).create? && location_equipment.available_service_kinds_for_assignment.any? %>
      <%= link_to new_location_equipment_location_equipment_service_path(location_equipment),
                  class: "btn btn-sm btn-primary py-0 px-1",
                  data: {turbo_frame: "remote_modal"} do %>
        <i class="fa-solid fa-plus"></i>
      <% end %>
    <% end %>
  </div>

  <% services = location_equipment.location_equipment_services.includes(:service_kind).order("service_kinds.name") %>
  <% if services.any? %>
    <ul class="list-unstyled mb-3">
      <% services.each do |les| %>
        <%= render "location_equipment_services/location_equipment_service",
                   location_equipment_service: les,
                   location_equipment: location_equipment %>
      <% end %>
    </ul>
  <% else %>
    <p class="text-white-50 small mb-3">Sin servicios programados</p>
  <% end %>
<% end %>
