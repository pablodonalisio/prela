<% assigning = location_equipment_service.assigning || location_equipment_service.new_record? %>
<% available_kinds = location_equipment.available_service_kinds_for_assignment %>
<% recurring_map = if assigning
  available_kinds.to_h { |sk| [sk.id.to_s, sk.recurring?] }
else
  {location_equipment_service.service_kind_id.to_s => location_equipment_service.service_kind.recurring?}
end %>
<% interval_defaults_map = available_kinds.to_h { |sk|
  [sk.id.to_s, {interval: sk.default_interval, interval_unit: sk.interval_unit}]
} %>
<% selected_kind = available_kinds.find { |sk| sk.id == location_equipment_service.service_kind_id } || available_kinds.first %>
<% recurring = assigning ? selected_kind&.recurring? : location_equipment_service.recurring? %>
<% form_options = {
  html: {
    data: {
      controller: "recurring-interval",
      recurring_interval_recurring_map_value: recurring_map.to_json,
      recurring_interval_interval_defaults_map_value: interval_defaults_map.to_json,
      recurring_interval_recurring_value: recurring
    }
  }
} %>
<% if assigning %>
  <% form_options[:url] = location_equipment_location_equipment_services_path(location_equipment) %>
  <% form_options[:method] = :post %>
<% end %>

<%= simple_form_for [location_equipment, location_equipment_service], form_options do |f| %>
  <% if assigning %>
    <%= f.input :service_kind_id,
                label: "Servicio",
                collection: available_kinds,
                label_method: :name,
                value_method: :id,
                include_blank: false,
                wrapper_html: {class: "!mb-0"},
                input_html: {
                  data: {
                    recurring_interval_target: "kindSelect",
                    action: "change->recurring-interval#kindChanged"
                  }
                } %>
    <p class="mb-3 text-sm text-body">
      ¿No encontrás el servicio?
      <%= link_to "Crear uno nuevo",
                  service_kinds_path(open: "new"),
                  class: "text-fg-brand hover:underline",
                  data: {turbo_frame: "_top"} %>.
    </p>
  <% else %>
    <p class="mb-5 text-sm font-semibold text-heading"><%= location_equipment_service.service_kind.name %></p>
  <% end %>

  <div data-recurring-interval-target="intervalFields" class="<%= "hidden" unless recurring %>">
    <%= f.input :interval,
                label: "Intervalo",
                as: :integer,
                input_html: {data: {recurring_interval_target: "intervalInput"}} %>
    <%= f.input :interval_unit,
                label: "Unidad",
                collection: LocationEquipmentService.interval_unit_options,
                include_blank: false,
                input_html: {data: {recurring_interval_target: "intervalUnitInput"}} %>
  </div>

  <% if assigning %>
    <%= f.input :due_on,
                label: "Próximo vencimiento",
                as: :date,
                html5: true,
                required: true,
                input_html: {
                  value: location_equipment_service.due_on || Date.current,
                  min: Date.new(Date.current.year - 30, 1, 1),
                  max: Date.new(Date.current.year + 90, 12, 31)
                } %>
  <% end %>

  <%= f.button :submit, "Aceptar" %>
<% end %>
