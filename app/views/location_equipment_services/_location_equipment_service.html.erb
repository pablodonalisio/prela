<%= content_tag :li, id: dom_id(location_equipment_service), class: "mb-2 flex items-start justify-between gap-2" do %>
  <div class="min-w-0">
    <p class="mb-0 text-sm text-heading"><%= location_equipment_service.service_kind.name %></p>
    <p class="mb-0 text-sm text-body-subtle"><%= location_equipment_service.interval_label %></p>
  </div>
  <% if policy(location_equipment_service).update? %>
    <div class="flex shrink-0 items-center gap-1">
      <%= link_to edit_location_equipment_location_equipment_service_path(location_equipment, location_equipment_service),
                  class: "rounded-lg border border-default px-3 py-1.5 text-sm text-body hover:bg-neutral-tertiary",
                  data: {turbo_frame: "remote_modal"},
                  aria: {label: "Editar"} do %>
        <%= icon(:edit) %>
      <% end %>
      <%= button_to location_equipment_location_equipment_service_path(location_equipment, location_equipment_service),
                    method: :delete,
                    class: "rounded-lg border border-red-500 px-3 py-1.5 text-sm text-red-500 hover:bg-red-50 dark:hover:bg-red-900/40",
                    form: {data: {turbo_confirm: "¿Seguro que querés quitar este servicio?"}},
                    aria: {label: "Eliminar"} do %>
        <%= icon(:trash) %>
      <% end %>
    </div>
  <% end %>
<% end %>
