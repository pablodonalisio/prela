<% selected_service_kind_id = params[:service_kind_id].presence %>
<% if selected_service_kind_id.nil? && params[:kind].present? %>
  <% selected_service_kind_id = ServiceKind.visible.find_by(legacy_key: params[:kind])&.id %>
<% end %>
<% select_classes = "block w-full rounded-lg border border-default bg-neutral-secondary-soft p-2.5 text-sm text-heading focus:border-brand focus:ring-brand" %>
<% secondary_btn = "inline-flex items-center justify-center rounded-lg border border-default bg-neutral-primary px-4 py-2.5 text-sm font-medium text-body transition-colors hover:bg-neutral-tertiary hover:text-heading focus:ring-4 focus:ring-brand-soft" %>

<%= form_with(url: root_path, method: :get, data: {turbo_frame: "overdue_service_date_list", turbo_action: "advance"}) do |form| %>
  <div class="flex flex-col gap-3 md:flex-row md:flex-wrap md:items-end">
    <div class="min-w-40 flex-1">
      <%= form.label :client_id, "Cliente", class: "mb-2 block text-sm font-medium text-heading" %>
      <%= form.collection_select :client_id, policy_scope(Client).all, :id, :name,
                                 {include_blank: "Todos", selected: params[:client_id]},
                                 class: select_classes %>
    </div>
    <div class="min-w-40 flex-1">
      <%= form.label :service_kind_id, "Tipo de servicio", class: "mb-2 block text-sm font-medium text-heading" %>
      <%= form.collection_select :service_kind_id,
                                 ServiceKind.visible.order(:name),
                                 :id,
                                 :name,
                                 {include_blank: "Todos", selected: selected_service_kind_id},
                                 class: select_classes %>
    </div>
    <div class="flex gap-2">
      <%= form.submit "Filtrar", class: ApplicationHelper::FLOWBITE_BUTTON_CLASSES %>
      <%= link_to "Limpiar filtros", root_path, class: secondary_btn,
                  data: {turbo_frame: "overdue_service_date_list", turbo_action: "advance"} %>
    </div>
  </div>
<% end %>
