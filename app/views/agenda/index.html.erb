<%= turbo_frame_tag "main_content" do %>
  <%= render "shared/content_header", title: "Agenda" %>

  <div class="p-4 md:px-6">
    <%= render "agenda/filter_form", from: @from, to: @to %>

    <% if @agenda_services.blank? %>
      <p class="my-4 text-center text-sm text-body-subtle">No hay servicios en este período</p>
    <% else %>
      <div class="mt-4" data-controller="scroll-to-list">
        <div id="agenda_services"
             class="scroll-mt-20 overflow-x-auto rounded-xl border border-default md:scroll-mt-28"
             data-scroll-to-list-target="list">
          <table class="w-full min-w-max text-left text-sm">
            <thead class="bg-neutral-secondary-medium text-xs uppercase tracking-wide text-body-subtle">
              <tr>
                <th class="whitespace-nowrap px-4 py-3 font-semibold">Vencimiento Service</th>
                <th class="whitespace-nowrap px-4 py-3 font-semibold">Inicio Service</th>
                <th class="whitespace-nowrap px-4 py-3 font-semibold">Fin Service</th>
                <th class="whitespace-nowrap px-4 py-3 font-semibold">Cliente</th>
                <th class="whitespace-nowrap px-4 py-3 font-semibold">Sede</th>
                <th class="whitespace-nowrap px-4 py-3 font-semibold">Equipo</th>
                <th class="whitespace-nowrap px-4 py-3 font-semibold">Tipo</th>
                <th class="whitespace-nowrap px-4 py-3 font-semibold">Prioridad</th>
                <th class="whitespace-nowrap px-4 py-3 font-semibold">Notas</th>
                <th class="whitespace-nowrap px-4 py-3 font-semibold">Técnicos</th>
                <th class="px-4 py-3 font-semibold"></th>
                <th class="px-4 py-3 font-semibold"></th>
              </tr>
            </thead>
            <tbody>
              <%= render partial: "agenda/row", collection: @agenda_services, as: :service_occurrence %>
            </tbody>
          </table>
        </div>

        <%= render "shared/pagination", pagy: @pagy %>
      </div>
    <% end %>
  </div>
<% end %>
