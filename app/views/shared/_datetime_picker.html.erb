<%# locals: (form:, field: :date, label: "Fecha", value: nil, disabled: false, min: nil, max: nil, required: false, blank: false, data: {}) %>
<% resolved = value || form.object.public_send(field) %>
<% resolved = Time.current if resolved.blank? && !blank %>
<% timestamp = resolved&.in_time_zone %>
<% date_id = "#{form.field_id(field)}_date" %>
<% time_id = "#{form.field_id(field)}_time" %>
<% invalid = form.object.errors[field].any? %>
<% input_classes = "block w-full rounded-lg border bg-neutral-secondary-medium p-2.5 text-sm text-heading placeholder:text-body-subtle focus:border-brand focus:ring-brand disabled:cursor-not-allowed disabled:opacity-60 #{invalid ? "border-red-500" : "border-default"}" %>

<%= tag.div class: "mb-5",
            data: {
              controller: "datetime-field",
              datetime_field_offset_value: Time.zone.now.formatted_offset
            }.merge(data || {}) do %>
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    <div>
      <%= form.label field, label, for: date_id, class: "mb-2 block text-sm font-medium text-heading" %>
      <%= tag.input type: "date",
                    id: date_id,
                    value: timestamp&.to_date&.iso8601,
                    disabled: disabled,
                    required: required,
                    min: min&.iso8601,
                    max: max&.iso8601,
                    class: input_classes,
                    data: {datetime_field_target: "date"} %>
    </div>
    <div>
      <%= form.label field, "Hora (formato 24hs)", for: time_id, class: "mb-2 block text-sm font-medium text-heading" %>
      <div class="relative">
        <div class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3.5">
          <%= icon(:clock, class: "text-body") %>
        </div>
        <%= tag.input type: "time",
                      id: time_id,
                      value: timestamp&.strftime("%H:%M"),
                      disabled: disabled,
                      step: 60,
                      autocomplete: "off",
                      class: input_classes.sub("p-2.5", "py-2.5 pe-2.5 ps-10"),
                      data: {
                        datetime_field_target: "time",
                        action: "input->datetime-field#sync change->datetime-field#sync blur->datetime-field#normalizeTime"
                      } %>
      </div>
    </div>
  </div>

  <%= form.hidden_field field,
                         value: timestamp&.iso8601,
                         disabled: disabled,
                         data: {datetime_field_target: "output"} %>

  <% if invalid %>
    <p class="mt-2 text-sm text-fg-danger"><%= form.object.errors.full_messages_for(field).to_sentence %></p>
  <% end %>
<% end %>
