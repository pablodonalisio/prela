<div class="flex-shrink-1 py-2">
  <% turbo_frame ||= "remote_modal"%>
  <% html_options = {
    class: "btn btn-primary text-uppercase h-100 font-monospace",
    style: "font-size: 0.8rem !important;",
    data: {turbo_frame: turbo_frame}
  } %>
  <% if text.present?%>
    <%= link_to text, path, html_options %>
  <% else %>
    <% html_options[:aria] = {label: "Button link"} %>
    <%= link_to path, html_options do %>
          <%= tag.i(class: icon) %>
    <% end %>
  <% end %>
</div>