<% if field_definitions&.any? %>
  <div class="row g-3">
    <% field_definitions.each do |field_key, definition| %>
      <% field_name = definition["name"] %>
      <% field_type = definition["type"] %>
      <% units = definition["units"] %>
      <% optimal_value = definition["optimal_value"] %>
      <% current_value = field_values[field_key] %>
      <% input_id = "#{id_prefix}_#{field_key}" %>
      <% input_name = "#{param_prefix}[#{field_key}]" %>
      <div class="col-sm-6 mb-2">
        <% if field_type == "boolean" %>
          <div class="form-check mt-4 pt-1">
            <input class="form-check-input"
                   type="checkbox"
                   id="<%= input_id %>"
                   name="<%= input_name %>"
                   value="1"
                   <%= "checked" if current_value %>>
            <label class="form-check-label" for="<%= input_id %>">
              <%= field_name %>
            </label>
          </div>
        <% else %>
          <label class="form-label small fw-medium" for="<%= input_id %>">
            <%= field_name %><% if units.present? && optimal_value.blank? %> <span class="text-muted fw-normal">(<%= units %>)</span><% end %>
          </label>
          <% if units.present? %>
            <div class="input-group input-group-sm">
              <% case field_type %>
              <% when "integer" %>
                <input class="form-control" type="number" step="1" id="<%= input_id %>" name="<%= input_name %>" value="<%= current_value %>">
              <% when "float" %>
                <input class="form-control" type="number" step="any" id="<%= input_id %>" name="<%= input_name %>" value="<%= current_value %>">
              <% when "date" %>
                <input class="form-control" type="date" id="<%= input_id %>" name="<%= input_name %>" value="<%= current_value %>">
              <% else %>
                <input class="form-control" type="text" id="<%= input_id %>" name="<%= input_name %>" value="<%= current_value %>">
              <% end %>
              <span class="input-group-text"><%= units %></span>
            </div>
          <% else %>
            <% case field_type %>
            <% when "integer" %>
              <input class="form-control form-control-sm" type="number" step="1" id="<%= input_id %>" name="<%= input_name %>" value="<%= current_value %>">
            <% when "float" %>
              <input class="form-control form-control-sm" type="number" step="any" id="<%= input_id %>" name="<%= input_name %>" value="<%= current_value %>">
            <% when "date" %>
              <input class="form-control form-control-sm" type="date" id="<%= input_id %>" name="<%= input_name %>" value="<%= current_value %>">
            <% else %>
              <input class="form-control form-control-sm" type="text" id="<%= input_id %>" name="<%= input_name %>" value="<%= current_value %>">
            <% end %>
          <% end %>
          <% if optimal_value.present? %>
            <div class="form-text"><%= t("activerecord.attributes.report_template.optimal_value") %>: <%= optimal_value %><% if units.present? %> <%= units %><% end %></div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
