<%# locals: (field_definitions:, field_values:, param_prefix:, id_prefix:) %>
<% if field_definitions&.any? %>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 mb-4">
    <% field_definitions.each do |field_key, definition| %>
      <% field_name = definition["name"] %>
      <% field_type = definition["type"] %>
      <% units = definition["units"] %>
      <% optimal_value = definition["optimal_value"] %>
      <% current_value = field_values[field_key] %>
      <% input_id = "#{id_prefix}_#{field_key}" %>
      <% input_name = "#{param_prefix}[#{field_key}]" %>
      <% input_classes = "block w-full rounded-lg border border-default bg-neutral-secondary-medium p-2.5 text-sm text-heading placeholder:text-body-subtle focus:border-brand focus:ring-brand" %>

      <div>
        <% if field_type == "boolean" %>
          <div class="flex h-full items-center gap-2 pt-6">
            <input class="h-4 w-4 rounded border-default bg-neutral-secondary-medium text-brand focus:ring-2 focus:ring-brand"
                   type="checkbox"
                   id="<%= input_id %>"
                   name="<%= input_name %>"
                   value="1"
                   <%= "checked" if current_value %>>
            <label class="text-sm font-medium text-heading" for="<%= input_id %>">
              <%= field_name %>
            </label>
          </div>
        <% else %>
          <label class="mb-2 block text-sm font-medium text-heading" for="<%= input_id %>">
            <%= field_name %><% if units.present? && optimal_value.blank? %> <span class="font-normal text-body-subtle">(<%= units %>)</span><% end %>
          </label>

          <% if units.present? %>
            <div class="flex">
              <% case field_type %>
              <% when "integer" %>
                <input class="<%= input_classes %> rounded-e-none" type="number" step="1" id="<%= input_id %>" name="<%= input_name %>" value="<%= current_value %>">
              <% when "float" %>
                <input class="<%= input_classes %> rounded-e-none" type="number" step="any" id="<%= input_id %>" name="<%= input_name %>" value="<%= current_value %>">
              <% when "date" %>
                <input class="<%= input_classes %> rounded-e-none" type="date" id="<%= input_id %>" name="<%= input_name %>" value="<%= current_value %>">
              <% else %>
                <input class="<%= input_classes %> rounded-e-none" type="text" id="<%= input_id %>" name="<%= input_name %>" value="<%= current_value %>">
              <% end %>
              <span class="inline-flex items-center rounded-e-lg border border-s-0 border-default bg-neutral-tertiary px-3 text-sm text-body-subtle"><%= units %></span>
            </div>
          <% else %>
            <% case field_type %>
            <% when "integer" %>
              <input class="<%= input_classes %>" type="number" step="1" id="<%= input_id %>" name="<%= input_name %>" value="<%= current_value %>">
            <% when "float" %>
              <input class="<%= input_classes %>" type="number" step="any" id="<%= input_id %>" name="<%= input_name %>" value="<%= current_value %>">
            <% when "date" %>
              <input class="<%= input_classes %>" type="date" id="<%= input_id %>" name="<%= input_name %>" value="<%= current_value %>">
            <% else %>
              <input class="<%= input_classes %>" type="text" id="<%= input_id %>" name="<%= input_name %>" value="<%= current_value %>">
            <% end %>
          <% end %>

          <% if optimal_value.present? %>
            <p class="mt-2 text-sm text-body-subtle">
              <%= t("activerecord.attributes.report_template.optimal_value") %>: <%= optimal_value %><% if units.present? %> <%= units %><% end %>
            </p>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
