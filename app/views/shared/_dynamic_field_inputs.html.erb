<% if field_definitions&.any? %>
  <div class="row g-3">
    <% field_definitions.each do |field_key, definition| %>
      <% field_name = definition["name"] %>
      <% field_type = definition["type"] %>
      <% current_value = field_values[field_key] %>
      <div class="col-sm-6 mb-2">
        <% if field_type == "boolean" %>
          <div class="form-check mt-4 pt-1">
            <input class="form-check-input"
                   type="checkbox"
                   id="<%= id_prefix %>_<%= field_key %>"
                   name="<%= param_prefix %>[<%= field_key %>]"
                   value="1"
                   <%= "checked" if current_value %>>
            <label class="form-check-label" for="<%= id_prefix %>_<%= field_key %>">
              <%= field_name %>
            </label>
          </div>
        <% else %>
          <label class="form-label small fw-medium"><%= field_name %></label>
          <% case field_type %>
          <% when "integer" %>
            <input class="form-control form-control-sm"
                   type="number"
                   step="1"
                   name="<%= param_prefix %>[<%= field_key %>]"
                   value="<%= current_value %>">
          <% when "float" %>
            <input class="form-control form-control-sm"
                   type="number"
                   step="any"
                   name="<%= param_prefix %>[<%= field_key %>]"
                   value="<%= current_value %>">
          <% when "date" %>
            <input class="form-control form-control-sm"
                   type="date"
                   name="<%= param_prefix %>[<%= field_key %>]"
                   value="<%= current_value %>">
          <% else %>
            <input class="form-control form-control-sm"
                   type="text"
                   name="<%= param_prefix %>[<%= field_key %>]"
                   value="<%= current_value %>">
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
