<%= turbo_frame_tag item do %>
  <div class="flex h-full flex-col overflow-hidden rounded-xl border border-default bg-neutral-primary shadow-sm transition-shadow hover:shadow-md">
    <% card_avatar = item.respond_to?(:display_avatar) ? item.display_avatar : item.avatar %>
    <% if card_avatar.attached? %>
      <%= image_tag card_avatar.variant(resize_and_pad: [300, 300]),
                    alt: "Imagen de #{item.name}",
                    class: "h-52 w-full bg-neutral-secondary-medium object-cover" %>
    <% else %>
      <%= image_tag "placeholder-img.jpeg",
                    alt: "Imagen de #{item.name}",
                    class: "h-52 w-full bg-neutral-secondary-medium object-cover" %>
    <% end %>

    <div class="flex min-w-0 flex-1 flex-col gap-3 p-4">
      <div class="flex flex-wrap items-center gap-1.5">
        <span class="font-semibold text-heading"><%= item.name %></span>
        <% if item.respond_to?(:tags) %>
          <% item.tags.kept.order(:name).each do |tag| %>
            <%= render "tags/badge", tag: tag %>
          <% end %>
        <% end %>
      </div>

      <% if lookup_context.template_exists?("item_info", item.class.to_s.underscore.pluralize, true) %>
        <div class="min-w-0 flex-1 text-sm text-body">
          <%= render partial: "#{item.class.to_s.underscore.pluralize}/item_info", locals: {item: item} %>
        </div>
      <% end %>

      <div class="mt-auto flex flex-wrap items-center gap-2">
        <%# Batteries open in the shared remote modal. Equipment cards still
            navigate to their own page. %>
        <%= link_to "Ver", url_for(item),
                    class: "inline-flex items-center rounded-lg bg-brand h-10 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-strong focus:ring-4 focus:ring-brand-soft",
                    data: {turbo_frame: (item.is_a?(Battery) ? "remote_modal" : :_top)} %>

        <% if lookup_context.template_exists?("item_actions", item.class.to_s.underscore.pluralize, true) %>
          <%= render partial: "#{item.class.to_s.underscore.pluralize}/item_actions", locals: {item: item} %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
