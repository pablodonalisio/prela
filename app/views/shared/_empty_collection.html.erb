<%# locals: (id:, message:, action_text: nil, action_path: nil) %>
<div id="<%= id %>" class="rounded-xl border border-dashed border-default bg-neutral-primary p-8 text-center">
  <p class="text-sm text-body-subtle <%= action_text.present? ? "mb-4" : "mb-0" %>"><%= message %></p>

  <% if action_text.present? && action_path.present? %>
    <div class="flex justify-center">
      <%= render "shared/button_link", text: action_text, path: action_path %>
    </div>
  <% end %>
</div>
