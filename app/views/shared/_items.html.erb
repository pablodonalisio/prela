<%# collection.name reaches the model class through ActiveRecord::Relation's
    delegation, matching the frame id the index turbo streams target. %>
<%= turbo_frame_tag collection.name.underscore.pluralize,
                    class: "grid grid-cols-1 gap-4 p-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" do %>
  <%= render partial: "shared/item", collection: collection, as: :item %>
<% end %>

<%= render "shared/pagination", pagy: pagy if local_assigns[:pagy] %>
