<% variant = local_assigns.fetch(:variant, :all) %>

<% if variant.in?(%i[all emergency]) %>
  <%= link_to CompanyInfo.emergency_whatsapp_url,
              class: "company-contact-item company-contact-item--emergency",
              target: "_blank",
              rel: "noopener noreferrer" do %>
    <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
    <span class="company-contact-text">
      <span class="company-contact-label"><%= CompanyInfo.emergency_phone_label %>:</span>
      <span class="company-contact-value"><%= CompanyInfo.emergency_phone %></span>
    </span>
  <% end %>
<% end %>

<% if variant.in?(%i[all secondary]) %>
  <%= link_to CompanyInfo.admin_whatsapp_url,
              class: "company-contact-item",
              target: "_blank",
              rel: "noopener noreferrer" do %>
    <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
    <span>
      <span class="company-contact-label"><%= CompanyInfo.admin_phone_label %>:</span>
      <%= CompanyInfo.admin_phone %>
    </span>
  <% end %>

  <%= link_to "mailto:#{CompanyInfo.email}", class: "company-contact-item" do %>
    <i class="fa-solid fa-envelope" aria-hidden="true"></i>
    <span><%= CompanyInfo.email %></span>
  <% end %>

  <span class="company-contact-item company-contact-item--static">
    <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
    <span><%= CompanyInfo.address %></span>
  </span>
<% end %>
