<nav class="sticky top-0 z-40 h-16 bg-primary-600 shadow-sm md:h-24">
  <div class="mx-auto flex h-full items-center gap-4 px-3 md:px-4">
    <%= link_to root_path, class: "flex h-10 shrink-0 items-center rounded-md bg-white px-2" do %>
      <%= image_tag "prela_logotipo-1.png", class: "w-auto", alt: "Prela" %>
    <% end %>

    <div class="hidden min-w-0 flex-1 items-center md:flex">
      <%= render "shared/company_contact_items" %>
    </div>

    <div class="flex min-w-0 flex-1 items-center md:hidden">
      <%= render "shared/company_contact_items", variant: :emergency %>
    </div>

    <div class="ml-auto flex shrink-0 items-center gap-1"
         data-controller="theme">
      <button type="button"
              class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-white/90 transition-colors hover:bg-white/10 hover:text-white focus:ring-2 focus:ring-white/40"
              data-action="theme#toggle"
              aria-label="Cambiar tema">
        <%# Dark is the default, so the moon starts visible. Wrappers own `hidden`
            because Font Awesome sets display on the <i> and would ignore it. %>
        <span data-theme-target="darkIcon"><%= icon(:theme_dark) %></span>
        <span class="hidden" data-theme-target="lightIcon"><%= icon(:theme_light) %></span>
      </button>

      <% if user_signed_in? %>
        <button type="button"
                class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-white/90 transition-colors hover:bg-white/10 hover:text-white focus:ring-2 focus:ring-white/40"
                data-dropdown-toggle="navbar-user-menu"
                data-dropdown-placement="bottom-end"
                aria-label="Abrir menú de usuario">
          <%= icon(:menu) %>
        </button>

        <div id="navbar-user-menu"
             class="z-50 hidden w-72 max-w-[calc(100vw-1.5rem)] divide-y divide-default rounded-base border border-default bg-neutral-primary-soft shadow-sm">
          <div class="px-4 py-3 text-sm text-heading">
            <div class="truncate font-medium"><%= current_user.email %></div>
          </div>

          <div class="px-4 py-3 md:hidden">
            <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-body-subtle">Contacto</p>
            <div class="flex flex-col gap-2 [&_a]:text-body [&_a:hover]:text-heading">
              <%= render "shared/company_contact_items", variant: :secondary %>
            </div>
          </div>

          <ul class="py-2 text-sm text-heading">
            <% if current_user.admin? %>
              <li>
                <%= link_to "Gestionar Usuarios",
                            users_path,
                            class: "block px-4 py-2 hover:bg-neutral-tertiary-medium hover:text-heading" %>
              </li>
            <% end %>

            <li>
              <%= button_to "Cerrar Sesión",
                            destroy_user_session_path,
                            method: :delete,
                            class: "block w-full px-4 py-2 text-left hover:bg-neutral-tertiary-medium hover:text-heading",
                            form: {class: "w-full"} %>
            </li>
          </ul>
        </div>
      <% end %>
    </div>
  </div>
</nav>
