<%# variant: :desktop renders a vertical rail, :mobile a bottom tab bar.
    The filter drawer is rendered once by the layout, not here, so that the two
    variants cannot produce duplicate element ids. %>
<% variant = local_assigns.fetch(:variant, :desktop) %>
<% links = sidebar_links.reject { |link| link[:admin] && !current_user.admin? } %>

<% if variant == :mobile %>
  <nav class="flex items-stretch" aria-label="Navegación principal">
    <% links.each do |link| %>
      <%= link_to link[:path],
                  class: "flex flex-1 flex-col items-center gap-1 px-1 py-2 text-[11px] font-medium transition-colors #{active_class(link[:path]).present? ? "text-fg-brand" : "text-body hover:text-heading"}",
                  data: {turbo: false} do %>
        <%= icon(link[:icon], class: "text-base") %>
        <span class="truncate"><%= link[:text] %></span>
      <% end %>
    <% end %>
  </nav>
<% else %>
  <nav class="flex flex-col gap-1 p-3" aria-label="Navegación principal">
    <% links.each do |link| %>
      <%= link_to link[:path],
                  class: "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors #{active_class(link[:path]).present? ? "bg-brand text-white" : "text-body hover:bg-neutral-tertiary hover:text-heading"}",
                  data: {turbo: false} do %>
        <%= icon(link[:icon], class: "w-5 shrink-0 text-center") %>
        <span class="truncate"><%= link[:text] %></span>
      <% end %>
    <% end %>
  </nav>

  <% if @filter_params %>
    <div class="border-t border-default px-3 py-4">
      <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-body-subtle">Filtros</h2>
      <%= render "filter_form", filter_params: @filter_params, order: @order %>
    </div>
  <% end %>
<% end %>
