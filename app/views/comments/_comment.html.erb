<%= content_tag :div, id: dom_id(comment), class: "flex items-start justify-between gap-2 border-b border-default px-3 py-2" do %>
  <div class="min-w-0 flex-1">
    <div class="mb-1 text-sm text-body"><%= simple_format(comment.description, class: "mb-0") %></div>
    <p class="m-0 text-xs text-body-subtle">
      Actualizado: <%= comment.updated_at.strftime("%d/%m/%Y") %>
    </p>
  </div>
  <% if current_user.admin? %>
    <div class="flex shrink-0 items-center gap-1">
      <%= link_to edit_location_equipment_comment_path(location_equipment, comment),
                  class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-neutral-tertiary hover:text-heading",
                  data: {turbo_frame: "remote_modal"},
                  aria: {label: "Editar"} do %>
        <%= icon(:edit) %>
      <% end %>
      <%= button_to location_equipment_comment_path(location_equipment, comment),
                    method: :delete,
                    class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-red-100 hover:text-red-700 dark:hover:bg-red-900/40",
                    form: {data: {turbo_confirm: "¿Estas seguro?"}},
                    aria: {label: "Eliminar"} do %>
        <%= icon(:trash) %>
      <% end %>
    </div>
  <% end %>
<% end %>
