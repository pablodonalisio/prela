<%= content_tag :div, id: dom_id(comment), class: "d-flex justify-content-between align-items-start gap-2 px-3 py-2 border-bottom border-white border-opacity-10" do %>
  <div class="min-w-0 flex-grow-1">
    <div class="mb-1"><%= simple_format(comment.description, class: "mb-0") %></div>
    <p class="m-0 fw-lighter text-white-50" style="font-size: 0.8rem;">
      Actualizado: <%= comment.updated_at.strftime("%d/%m/%Y") %>
    </p>
  </div>
  <% if current_user.admin? %>
    <div class="d-flex align-items-center flex-shrink-0">
      <%= link_to edit_location_equipment_comment_path(location_equipment, comment), class: "ms-2", data: { turbo_frame: "remote_modal" } do %>
        <i class="fas fa-edit"></i>
      <% end %>
      <%= button_to location_equipment_comment_path(location_equipment, comment), class: "btn btn-sm", form_class: "d-inline", method: :delete, form: { data: { turbo_confirm: "¿Estas seguro?" } } do %>
        <i class="fas fa-trash text-danger"></i>
      <% end %>
    </div>
  <% end %>
<% end %>
