<div id="comments">
  <% if comments.empty? %>
    <p id="empty_comments" class="mb-0 px-3 text-sm text-body-subtle">Sin comentarios</p>
  <% else %>
    <%= render partial: "comments/comment", collection: comments, as: :comment, locals: {location_equipment: location_equipment} %>
  <% end %>
</div>
