<%= content_tag :tr, id: dom_id(signature), class: "border-t border-default" do %>
  <td class="px-4 py-3 align-middle">
    <% if signature.image.attached? %>
      <%= image_tag signature.image.variant(resize_to_limit: [80, 40]),
                    alt: signature.name,
                    class: "h-10 w-auto object-contain" %>
    <% end %>
  </td>
  <td class="px-4 py-3 align-middle text-heading"><%= signature.name %></td>
  <td class="px-4 py-3 align-middle text-body"><%= signature.title %></td>
  <td class="px-4 py-3 align-middle">
    <div class="flex items-center gap-1">
      <%= link_to edit_signature_path(signature),
                  class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-neutral-tertiary hover:text-heading",
                  data: {turbo_frame: "remote_modal"},
                  aria: {label: "Editar"} do %>
        <%= icon(:edit) %>
      <% end %>
      <%= button_to signature_path(signature),
                    method: :delete,
                    class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-red-100 hover:text-red-700 dark:hover:bg-red-900/40",
                    form: {data: {turbo_confirm: "¿Estás seguro?"}},
                    aria: {label: "Eliminar"} do %>
        <%= icon(:trash) %>
      <% end %>
    </div>
  </td>
<% end %>
