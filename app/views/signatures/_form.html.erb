<%= simple_form_for signature do |f| %>
  <%= f.input :name, label: "Nombre" %>
  <%= f.input :title, label: "Cargo" %>
  <%= f.input :image, label: "Imagen", as: :file, input_html: {accept: "image/*"} %>
  <% if signature.image.attached? %>
    <div class="mb-4">
      <%= image_tag signature.image.variant(resize_to_limit: [200, 100]),
                    alt: signature.name,
                    class: "h-16 w-auto rounded-lg object-contain" %>
    </div>
  <% end %>
  <%= f.button :submit, "Aceptar" %>
<% end %>
