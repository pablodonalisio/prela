<tbody id="signatures">
  <% if signatures.any? %>
    <%= render partial: "signatures/signature_table_row", collection: signatures, as: :signature %>
  <% else %>
    <tr id="empty_signatures">
      <td colspan="4" class="px-4 py-6 text-center text-body-subtle">No hay firmas cargadas.</td>
    </tr>
  <% end %>
</tbody>
