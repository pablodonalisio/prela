<%= turbo_frame_tag "main_content" do %>
  <%= render "users/navbar", active: "signatures" %>

  <%= render "shared/content_header", title: "Firmas" do %>
    <%= render "shared/button_link", text: "Agregar", path: new_signature_path %>
  <% end %>

  <div class="overflow-x-auto p-4 md:px-6">
    <div class="overflow-hidden rounded-xl border border-default">
      <table class="w-full text-left text-sm">
        <thead class="bg-neutral-secondary-medium text-xs uppercase tracking-wide text-body-subtle">
          <tr>
            <th class="px-4 py-3 font-semibold">Imagen</th>
            <th class="px-4 py-3 font-semibold">Nombre</th>
            <th class="px-4 py-3 font-semibold">Cargo</th>
            <th class="px-4 py-3 font-semibold">Acciones</th>
          </tr>
        </thead>
        <%= render "signatures/signatures_table", signatures: @signatures %>
      </table>
    </div>
  </div>
<% end %>
