<%= turbo_stream.update "flash" do %>
  <%= render "layouts/flash" %>
<% end %>

<% if @discarded %>
  <%= turbo_stream.remove @supply_kind %>
  <% if policy_scope(SupplyKind).none? %>
    <%= turbo_stream.append "supply_kinds" do %>
      <%= render "shared/empty_collection",
                 id: "supply_kinds_empty",
                 message: "No hay tipos de insumo todavía.",
                 action_text: policy(SupplyKind).create? ? "Agregar" : nil,
                 action_path: policy(SupplyKind).create? ? new_supply_kind_path : nil %>
    <% end %>
  <% end %>
<% end %>
