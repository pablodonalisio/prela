<%= content_tag :tr, id: dom_id(document), class: "border-t border-default" do %>
  <td class="px-4 py-3 align-middle">
    <p class="m-0 text-heading">
      <%= document.description.capitalize %>
      <% if current_user.admin? && !document.public? %>
        <span class="ms-1 inline-flex items-center rounded-full bg-neutral-tertiary px-2.5 py-0.5 text-xs font-medium text-body">Privado</span>
      <% end %>
    </p>
    <p class="m-0 text-xs text-body-subtle">Fecha: <%= document.created_at.strftime("%d/%m/%Y") %></p>
  </td>
  <td class="px-4 py-3 align-middle">
    <div class="flex items-center gap-1">
      <% if document.file.attached? %>
        <%= link_to polymorphic_path([documentable, document]),
                    class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-neutral-tertiary hover:text-heading",
                    data: {turbo_frame: "remote_modal"},
                    aria: {label: "Ver"} do %>
          <%= icon(:file) %>
        <% end %>
      <% end %>
      <% if current_user.admin? %>
        <%= link_to edit_polymorphic_path([documentable, document]),
                    class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-neutral-tertiary hover:text-heading",
                    data: {turbo_frame: "remote_modal"},
                    aria: {label: "Editar"} do %>
          <%= icon(:edit) %>
        <% end %>
        <%= button_to polymorphic_path([documentable, document]),
                      method: :delete,
                      class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-red-100 hover:text-red-700 dark:hover:bg-red-900/40",
                      form: {data: {turbo_confirm: "¿Estas seguro?"}},
                      aria: {label: "Eliminar"} do %>
          <%= icon(:trash) %>
        <% end %>
      <% end %>
    </div>
  </td>
<% end %>
