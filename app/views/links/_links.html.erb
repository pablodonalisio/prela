<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h2 class="text-xl font-bold text-heading">Enlaces de interés</h2>
  <%= render "shared/button_link", text: "Agregar", path: new_link_path %>
</div>

<div class="overflow-x-auto rounded-xl border border-default">
  <table class="w-full text-center text-sm">
    <thead class="bg-neutral-secondary-medium text-xs uppercase tracking-wide text-body-subtle">
      <tr>
        <th scope="col" class="px-4 py-3 font-semibold">Título</th>
        <th scope="col" class="px-4 py-3 font-semibold">Acciones</th>
      </tr>
    </thead>
    <%= render "links/links_table", links: links %>
  </table>
</div>
