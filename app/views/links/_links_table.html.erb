<tbody id="links">
  <% if links.empty? %>
    <tr id="empty_links">
      <td colspan="<%= policy(Link).update? ? 2 : 1 %>" class="px-4 py-6 text-body-subtle">No hay links</td>
    </tr>
  <% else %>
    <%= render partial: "links/links_table_row", collection: links, as: :link %>
  <% end %>
</tbody>
