<%= simple_form_for tag do |f| %>
  <%= f.input :name, label: "Nombre" %>
  <%= f.input :color, label: "Color",
                      as: :string,
                      input_html: {
                        type: "color",
                        value: tag.color.presence || Tag::DEFAULT_COLOR,
                        class: "h-10 w-20 cursor-pointer rounded-lg border border-default bg-neutral-secondary-medium p-1"
                      } %>

  <%= f.button :submit, "Aceptar" %>
<% end %>
