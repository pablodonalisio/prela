<%= turbo_frame_tag tag do %>
  <div class="rounded-xl border border-default bg-neutral-primary p-4">
    <div class="flex flex-col items-start gap-3 md:flex-row md:items-center">
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-2">
          <%= render "tags/badge", tag: tag %>
          <span class="inline-flex items-center rounded-full bg-neutral-tertiary px-2.5 py-0.5 text-xs font-medium text-body">
            <%= tag.location_equipments_count %>
            <%= tag.location_equipments_count == 1 ? "activo" : "activos" %> usándola
          </span>
        </div>
      </div>

      <% if current_user.admin? %>
        <div class="shrink-0 self-end md:self-center">
          <%= render "shared/dropdown" do %>
            <%= render "shared/button_box",
                       edit_path: edit_tag_path(tag),
                       delete_path: tag_path(tag),
                       confirm: "¿Seguro que querés borrar esta etiqueta?" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
