<%= turbo_frame_tag "main_content" do %>
  <div class="mx-auto max-w-5xl space-y-6 p-4 md:p-6">
    <section class="rounded-xl border border-default bg-neutral-primary p-4 md:p-5">
      <%= render "control_panel/control_panel", control_panel_services: @control_panel_services %>
    </section>

    <% if current_user.admin? %>
      <section class="rounded-xl border border-default bg-neutral-primary p-4 md:p-5">
        <%= render "links/links", links: @links %>
      </section>
    <% end %>
  </div>
<% end %>
