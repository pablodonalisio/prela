<%= content_tag :tr, id: dom_id(user), class: "border-t border-default" do %>
  <td class="px-4 py-3 align-middle text-heading"><%= user.email %></td>
  <td class="px-4 py-3 align-middle text-body"><%= user.full_role %></td>
  <td class="px-4 py-3 align-middle text-body"><%= user.client&.name %></td>
  <td class="px-4 py-3 align-middle">
    <div class="flex items-center gap-1">
      <%= link_to edit_user_path(user),
                  class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-neutral-tertiary hover:text-heading",
                  data: {turbo_frame: "remote_modal"},
                  aria: {label: "Editar"} do %>
        <%= icon(:edit) %>
      <% end %>
      <%= link_to edit_user_path(user, change_password: true),
                  class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-neutral-tertiary hover:text-heading",
                  data: {turbo_frame: "remote_modal"},
                  aria: {label: "Cambiar contraseña"} do %>
        <%= icon(:key) %>
      <% end %>
      <%= button_to user_path(user),
                    method: :delete,
                    class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-red-100 hover:text-red-700 dark:hover:bg-red-900/40",
                    form: {data: {turbo_confirm: "¿Estas seguro?"}},
                    aria: {label: "Eliminar"} do %>
        <%= icon(:trash) %>
      <% end %>
    </div>
  </td>
<% end %>
