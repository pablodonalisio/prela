<%# locals: (active:) %>
<nav class="border-b border-default px-4 pt-4 md:px-6" aria-label="Sección de usuarios">
  <h1 class="mb-3 text-2xl font-bold text-heading">Usuarios</h1>

  <ul class="-mb-px flex flex-wrap gap-1 text-sm font-medium">
    <% [
      ["Usuarios", users_path, "users"],
      ["Firmas", signatures_path, "signatures"]
    ].each do |label, path, key| %>
      <li>
        <%= link_to label, path,
                    class: "inline-block border-b-2 px-4 py-3 #{active == key ? "border-brand text-fg-brand" : "border-transparent text-body hover:border-default hover:text-heading"}",
                    data: {turbo_frame: "_top"} %>
      </li>
    <% end %>
  </ul>
</nav>
