<%= turbo_frame_tag "main_content", class: "w-100" do %>
  <%= render "users/navbar", active: "users" %>

  <%= render "shared/content_header", title: "Usuarios" do %>
    <%= render "shared/button_link", text: "Agregar",
                                    path: new_user_path %>
  <% end %>

  <div class="w-100 overflow-auto px-4">
    <table class="table mt-4">
      <thead class="thead-dark">
        <tr>
          <th>Email</th>
          <th>Rol</th>
          <th>Cliente</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <%= render "users/users_table", users: @users %>
    </table>
  </div>
<% end %>
