<%= turbo_frame_tag "main_content" do %>
  <%= render "users/navbar", active: "users" %>

  <%= render "shared/content_header", title: "Usuarios" do %>
    <%= render "shared/button_link", text: "Agregar", path: new_user_path %>
  <% end %>

  <div class="overflow-x-auto p-4 md:px-6">
    <div class="overflow-hidden rounded-xl border border-default">
      <table class="w-full text-left text-sm">
        <thead class="bg-neutral-secondary-medium text-xs uppercase tracking-wide text-body-subtle">
          <tr>
            <th class="px-4 py-3 font-semibold">Email</th>
            <th class="px-4 py-3 font-semibold">Rol</th>
            <th class="px-4 py-3 font-semibold">Cliente</th>
            <th class="px-4 py-3 font-semibold">Acciones</th>
          </tr>
        </thead>
        <%= render "users/users_table", users: @users %>
      </table>
    </div>
  </div>
<% end %>
