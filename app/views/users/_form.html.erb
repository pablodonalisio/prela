<%= simple_form_for user, html: {data: {controller: "user-form"}} do |f| %>
  <%= f.input :email, label: "Email" %>
  <% if user.new_record? %>
    <%= f.input :password, label: "Password" %>
  <% end %>
  <% if current_user.admin? %>
    <%= f.input :role, label: "Rol",
                collection: User.enum_attributes_for_select("role"),
                include_blank: false,
                input_html: {data: {user_form_target: "role", action: "change->user-form#toggleClientFields"}} %>
    <div data-user-form-target="clientFields" class="<%= "hidden" unless user.client? %>">
      <%= f.input :editor, label: "Editor", collection: [
        ["No", false],
        ["Sí", true]
      ], include_blank: false %>
      <%= f.association :client, label: "Cliente", label_method: :name, value_method: :id %>
    </div>
  <% end %>
  <%= f.button :submit, "Aceptar" %>
<% end %>
