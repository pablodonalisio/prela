<%= turbo_frame_tag "main_content" do %>
  <div class="client-show mx-4 mb-8 mt-4 space-y-4 md:mx-6">
    <%= link_to "← Volver a clientes", clients_path,
                class: "inline-flex text-sm text-body hover:text-heading hover:underline",
                data: {turbo_frame: "_top"} %>

    <div class="flex items-center gap-4 rounded-xl border border-default bg-neutral-primary p-5">
      <% if @client.avatar.attached? %>
        <%= image_tag @client.avatar.variant(resize_to_limit: [128, 128]),
                      class: "h-16 w-16 rounded-xl object-cover",
                      alt: @client.name %>
      <% else %>
        <div class="flex h-16 w-16 items-center justify-center rounded-xl bg-neutral-secondary-medium text-xl text-fg-brand">
          <%= icon(:building) %>
        </div>
      <% end %>
      <div class="min-w-0">
        <p class="mb-1 text-xs font-medium uppercase tracking-wide text-body-subtle">Cliente</p>
        <h2 class="text-2xl font-bold text-heading"><%= @client.name %></h2>
      </div>
    </div>

    <div class="border-b border-default">
      <ul class="-mb-px flex flex-wrap gap-1 text-sm font-medium" id="client-tabs" data-tabs-toggle="#client-tabs-content" role="tablist">
        <li role="presentation">
          <button class="inline-block border-b-2 px-4 py-3" id="client-sedes-tab"
                  data-tabs-target="#client-sedes" type="button" role="tab"
                  aria-controls="client-sedes" aria-selected="true">Sedes</button>
        </li>
        <li role="presentation">
          <button class="inline-block border-b-2 px-4 py-3" id="client-contactos-tab"
                  data-tabs-target="#client-contactos" type="button" role="tab"
                  aria-controls="client-contactos" aria-selected="false">Contactos</button>
        </li>
        <li role="presentation">
          <button class="inline-block border-b-2 px-4 py-3" id="client-organigrama-tab"
                  data-tabs-target="#client-organigrama" type="button" role="tab"
                  aria-controls="client-organigrama" aria-selected="false">Organigrama</button>
        </li>
      </ul>
    </div>

    <div id="client-tabs-content">
      <div class="rounded-xl border border-default bg-neutral-primary" id="client-sedes" role="tabpanel" aria-labelledby="client-sedes-tab">
        <div class="flex items-center justify-between gap-4 border-b border-default px-5 py-4">
          <h3 class="text-lg font-semibold text-heading">Sedes</h3>
          <%= render "shared/button_link", text: "Agregar", path: [:new, @client, :location] %>
        </div>
        <div class="p-5">
          <div id="locations" class="flex flex-wrap gap-2">
            <% kept_locations = @client.locations.kept %>
            <% if kept_locations.any? %>
              <%= render kept_locations, client: @client %>
            <% else %>
              <div id="empty_locations" class="w-full text-sm text-body-subtle">
                Todavía no hay sedes cargadas.
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <div class="hidden rounded-xl border border-default bg-neutral-primary" id="client-contactos" role="tabpanel" aria-labelledby="client-contactos-tab">
        <div class="flex items-center justify-between gap-4 border-b border-default px-5 py-4">
          <h3 class="text-lg font-semibold text-heading">Contactos</h3>
          <%= render "shared/button_link", text: "Agregar", path: [:new, @client, :contact] %>
        </div>
        <div class="overflow-x-auto p-2 md:p-4">
          <table class="w-full text-left text-sm">
            <thead class="text-xs uppercase tracking-wide text-body-subtle">
              <tr>
                <th class="px-3 py-3 font-semibold">Nombre</th>
                <th class="px-3 py-3 font-semibold">Puesto</th>
                <th class="px-3 py-3 font-semibold">Área</th>
                <th class="px-3 py-3 font-semibold">Sedes</th>
                <th class="px-3 py-3 font-semibold">Email</th>
                <th class="px-3 py-3 font-semibold">Teléfono</th>
                <th class="px-3 py-3 text-end font-semibold">Acciones</th>
              </tr>
            </thead>
            <tbody id="contacts">
              <% kept_contacts = @client.contacts.kept.includes(:locations) %>
              <% if kept_contacts.any? %>
                <%= render kept_contacts, client: @client %>
              <% else %>
                <tr id="empty_contacts">
                  <td colspan="7" class="px-3 py-6 text-center text-sm text-body-subtle">
                    Todavía no hay contactos cargados.
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="hidden rounded-xl border border-default bg-neutral-primary" id="client-organigrama" role="tabpanel" aria-labelledby="client-organigrama-tab">
        <div class="border-b border-default px-5 py-4">
          <h3 class="text-lg font-semibold text-heading">Organigrama</h3>
        </div>
        <div class="p-5">
          <div id="organigram">
            <%= render "contacts/organigram", client: @client %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
