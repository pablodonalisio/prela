<%= turbo_frame_tag service_kind do %>
  <div class="rounded-xl border border-default bg-neutral-primary p-4">
    <div class="flex flex-col items-start gap-3 md:flex-row md:items-center">
      <div class="min-w-0 flex-1">
        <h5 class="mb-1 font-semibold text-heading"><%= service_kind.name %></h5>

        <div class="flex flex-wrap gap-2">
          <span class="inline-flex items-center rounded-full bg-neutral-tertiary px-2.5 py-0.5 text-xs font-medium text-body">
            <%= service_kind.interval_label %>
          </span>
          <span class="inline-flex items-center rounded-full bg-neutral-tertiary px-2.5 py-0.5 text-xs font-medium text-body">
            <%= service_kind.priority_label %>
          </span>
          <% service_kind.equipment_kinds.visible.order(:name).each do |equipment_kind| %>
            <span class="inline-flex items-center rounded-full bg-brand-soft px-2.5 py-0.5 text-xs font-medium text-fg-brand">
              <%= equipment_kind.name %>
            </span>
          <% end %>
        </div>
      </div>

      <% if current_user.admin? %>
        <div class="shrink-0 self-end md:self-center">
          <%= render "shared/dropdown" do %>
            <%= render "shared/button_box",
                       edit_path: edit_service_kind_path(service_kind),
                       delete_path: service_kind_path(service_kind),
                       confirm: "¿Seguro que querés borrar este tipo de servicio?" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
