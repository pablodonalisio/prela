<%= turbo_frame_tag service_kind do %>
  <div class="bg-secondary rounded p-3">
    <div class="d-flex align-items-start align-items-md-center gap-3 flex-column flex-md-row">
      <div class="flex-grow-1 min-w-0">
        <h5 class="mb-1 text-white"><%= service_kind.name %></h5>

        <div class="d-flex flex-wrap gap-2">
          <span class="badge rounded-pill text-bg-dark">
            <%= service_kind.interval_label %>
          </span>
          <span class="badge rounded-pill text-bg-dark">
            <%= service_kind.priority_label %>
          </span>
        </div>
      </div>

      <% if current_user.admin? %>
        <div class="flex-shrink-0 align-self-end align-self-md-center">
          <%= render "shared/dropdown" do %>
            <%= render "shared/button_box",
                       edit_path: edit_service_kind_path(service_kind),
                       delete_path: service_kind_path(service_kind),
                       confirm: "¿Seguro que querés borrar este tipo de servicio?" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
