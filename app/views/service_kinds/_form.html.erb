<%= simple_form_for service_kind, html: {data: {controller: "recurring-interval"}} do |f| %>
  <%= f.input :name, label: "Nombre" %>
  <%= f.input :recurring,
              as: :boolean,
              label: "Recurrente",
              input_html: {
                data: {
                  recurring_interval_target: "recurringInput",
                  action: "change->recurring-interval#toggle"
                }
              } %>
  <div data-recurring-interval-target="intervalFields">
    <%= f.input :default_interval, label: "Intervalo", as: :integer %>
    <%= f.input :interval_unit,
                label: "Unidad",
                collection: ServiceKind.interval_unit_options,
                include_blank: false %>
  </div>
  <%= f.input :priority,
              label: "Prioridad",
              collection: ServiceKind.priority_options,
              include_blank: false %>

  <%= f.button :submit, "Aceptar" %>
<% end %>
