<%# locals: (f:, report_template:) %>
<div class="mb-5" data-controller="nested-form">
  <label class="mb-2 block text-sm font-medium text-heading"><%= t("activerecord.attributes.report_template.tasks") %></label>
  <div class="rounded-lg border border-default p-3">
    <div data-nested-form-target="container">
      <%= f.simple_fields_for :report_template_tasks do |task_form| %>
        <%= render "report_template_task_fields", f: task_form %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= f.simple_fields_for :report_template_tasks, ReportTemplateTask.new, child_index: "NEW_RECORD" do |task_form| %>
        <%= render "report_template_task_fields", f: task_form %>
      <% end %>
    </template>
  </div>

  <div class="my-2">
    <button type="button"
            class="inline-flex items-center rounded-lg border border-default px-3 py-1.5 text-sm text-body hover:bg-neutral-tertiary"
            data-action="nested-form#add">
      <%= t("activerecord.attributes.report_template.add_task") %>
    </button>
  </div>
</div>
