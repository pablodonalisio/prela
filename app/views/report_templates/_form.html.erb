<%= simple_form_for report_template, html: {data: {turbo_frame: "_top"}} do |f| %>
  <div class="mb-8 rounded-xl border border-default bg-neutral-primary-soft p-4 [&>:last-child]:mb-0 md:p-5"
       data-fixed-sections>
    <%= f.input :name, label: "Nombre" %>

    <% ReportTemplate::FIXED_SECTIONS.each do |section| %>
      <%= render "section_fields",
                 section: section,
                 report_template: report_template %>
    <% end %>
  </div>

  <div data-controller="sortable-sections">
    <div data-sortable-sections-target="list"
         data-action="dragover->sortable-sections#dragOver">
      <% report_template.layout_blocks.each_with_index do |block, index| %>
        <%= render "layout_block",
                   block: block,
                   index: index,
                   report_template: report_template,
                   f: f %>
      <% end %>
    </div>

    <template data-sortable-sections-target="observationsTemplate">
      <%= render "layout_block",
                 block: {"id" => "NEW_ID", "type" => "observations"},
                 index: "NEW_INDEX",
                 report_template: report_template,
                 f: f %>
    </template>

    <template data-sortable-sections-target="imagesTemplate">
      <%= render "layout_block",
                 block: {"id" => "NEW_ID", "type" => "images"},
                 index: "NEW_INDEX",
                 report_template: report_template,
                 f: f %>
    </template>

    <div class="mb-5 flex flex-wrap gap-2">
      <button type="button"
              class="inline-flex items-center rounded-lg border border-default px-3 py-1.5 text-sm text-body hover:bg-neutral-tertiary"
              data-action="sortable-sections#add"
              data-sortable-sections-kind-param="observations">
        <%= t("activerecord.attributes.report_template.add_observations") %>
      </button>
      <button type="button"
              class="inline-flex items-center rounded-lg border border-default px-3 py-1.5 text-sm text-body hover:bg-neutral-tertiary"
              data-action="sortable-sections#add"
              data-sortable-sections-kind-param="images">
        <%= t("activerecord.attributes.report_template.add_images") %>
      </button>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-3 mb-4">
    <%= f.button :submit, "Aceptar" %>
    <%= link_to "Volver", report_templates_path,
                class: "inline-flex items-center rounded-lg border border-default bg-neutral-primary px-4 py-2 text-sm font-medium text-body hover:bg-neutral-tertiary hover:text-heading",
                data: {turbo_frame: "_top"} %>
  </div>
<% end %>
