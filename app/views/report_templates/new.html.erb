<%= turbo_frame_tag "main_content" do %>
  <%= render "shared/content_header", title: "Nueva plantilla de informe de control" do %>
    <%= link_to "Volver", report_templates_path,
                class: "inline-flex items-center rounded-lg border border-default bg-neutral-primary px-4 py-2 text-sm font-medium text-body hover:bg-neutral-tertiary hover:text-heading",
                data: {turbo_frame: "_top"} %>
  <% end %>

  <div class="mx-4 mb-8 mt-4 md:mx-6">
    <div class="rounded-xl border border-default bg-neutral-primary p-4 md:p-6">
      <%= render "form", report_template: @report_template %>
    </div>
  </div>
<% end %>
