<%# locals: (fields:) %>
<% if fields.present? %>
  <% field_columns = fields.to_a.each_slice(4).to_a %>
  <div class="mb-2 grid grid-cols-1 gap-2 text-sm md:grid-cols-2">
    <% field_columns.each do |column| %>
      <div>
        <ul class="mb-0 list-none">
          <% column.each do |_field_key, field_data| %>
            <li class="py-1">
              <strong class="text-heading"><%= field_data["name"] %></strong>
              <span class="text-body-subtle">(<%= t("activerecord.attributes.equipment_kind.field_types.#{field_data['type']}") %>)</span>
              <% if field_data["units"].present? %>
                <span class="text-body-subtle">· <%= field_data["units"] %></span>
              <% end %>
              <% if field_data["optimal_value"].present? %>
                <span class="text-body-subtle">· <%= t("activerecord.attributes.report_template.optimal_value") %>: <%= field_data["optimal_value"] %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="mb-0 text-sm text-body-subtle">Ninguno definido.</p>
<% end %>
