<%# locals: (fields:) %>
<% if fields.present? %>
  <% field_columns = fields.to_a.each_slice(4).to_a %>
  <div class="row row-cols-1 row-cols-md-2 g-2 mb-2 small">
    <% field_columns.each do |column| %>
      <div class="col">
        <ul class="list-unstyled mb-0">
          <% column.each do |_field_key, field_data| %>
            <li class="py-1">
              <strong><%= field_data["name"] %></strong>
              <span class="text-muted">(<%= t("activerecord.attributes.equipment_kind.field_types.#{field_data['type']}") %>)</span>
              <% if field_data["units"].present? %>
                <span class="text-muted">· <%= field_data["units"] %></span>
              <% end %>
              <% if field_data["optimal_value"].present? %>
                <span class="text-muted">· <%= t("activerecord.attributes.report_template.optimal_value") %>: <%= field_data["optimal_value"] %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-muted small mb-0">Ninguno definido.</p>
<% end %>
