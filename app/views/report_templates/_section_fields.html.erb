<%# locals: (section:, report_template:) %>
<div class="mb-5">
  <label class="mb-2 block text-sm font-medium text-heading"><%= t("activerecord.attributes.report_template.sections.#{section}") %></label>
  <% if report_template.errors[section.to_sym].any? %>
    <div class="mb-2 text-sm text-red-500">
      <%= report_template.errors[section.to_sym].first %>
    </div>
  <% end %>
  <div class="rounded-lg border p-3 <%= report_template.errors[section.to_sym].any? ? "border-red-500" : "border-default" %>">
    <% container_id = "fields-container-#{section.dasherize}" %>
    <% no_fields_id = "no-fields-message-#{section.dasherize}" %>
    <div data-controller="sortable-fields">
      <%= turbo_frame_tag container_id,
                          data: {
                            sortable_fields_target: "list",
                            action: "dragover->sortable-fields#dragOver"
                          } do %>
        <% fields = report_template.fields_for(section) %>
        <% if fields.any? %>
          <% fields.each do |field_key, field_data| %>
            <%= render "report_template_field",
                       report_template: report_template,
                       section: section,
                       field_key: field_key,
                       field_data: field_data %>
          <% end %>
        <% else %>
          <%= turbo_frame_tag no_fields_id do %>
            <p class="mb-0 text-sm text-body-subtle">No hay campos definidos.</p>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="my-2">
    <%= link_to "Añadir campo",
                add_field_report_templates_path(section: section),
                class: "inline-flex items-center rounded-lg border border-default px-3 py-1.5 text-sm text-body hover:bg-neutral-tertiary",
                data: {turbo_stream: true} %>
  </div>
</div>
