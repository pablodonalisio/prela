<%# locals: (f:) %>
<% input_classes = "block w-full rounded-lg border border-default bg-neutral-secondary-medium p-2.5 text-sm text-heading" %>
<% section = f.object %>
<% table_section = section.table_section || TableSection.new(row_count: 1, column_count: 1) %>
<% list_section = section.list_section || ListSection.new %>
<% kind_key = section.section_kind&.key || "text" %>
<div class="mb-3 flex items-start gap-2" data-controller="section-kind" data-nested-form-target="item" data-sortable-fields-target="item">
  <%= f.hidden_field :id %>
  <%= f.hidden_field :position, data: {sortable_fields_position: true} %>
  <%= f.hidden_field :_destroy, value: "0" %>

  <button type="button"
          class="drag-handle mt-8 inline-flex shrink-0 cursor-grab items-center px-1 text-body-subtle"
          draggable="true"
          tabindex="-1"
          aria-label="<%= t("activerecord.attributes.report_template.reorder_section") %>"
          data-action="dragstart->sortable-fields#dragStart dragend->sortable-fields#dragEnd">
    <%= icon(:grip) %>
  </button>

  <div class="min-w-0 flex-1 rounded-lg border border-default p-3">
  <div class="mb-3 flex flex-wrap items-start gap-2">
    <div class="min-w-40">
      <label class="mb-2 block text-sm font-medium text-heading">Tipo</label>
      <select class="<%= input_classes %>"
              name="<%= f.object_name %>[section_kind_id]"
              data-section-kind-target="kind"
              data-action="change->section-kind#toggle">
        <% SectionKind.order(:id).each do |kind| %>
          <option value="<%= kind.id %>"
                  data-key="<%= kind.key %>"
                  <%= "selected" if section.section_kind_id == kind.id || (section.section_kind_id.blank? && kind.key == "text") %>>
            <%= kind.name %>
          </option>
        <% end %>
      </select>
    </div>

    <div class="min-w-48 flex-1">
      <label class="mb-2 block text-sm font-medium text-heading">Título</label>
      <input class="<%= input_classes %> <%= "border-red-500" if section.errors[:title].any? %>"
             type="text"
             name="<%= f.object_name %>[title]"
             value="<%= section.title %>"
             placeholder="ej: Mediciones">
      <% if section.errors[:title].any? %>
        <p class="mt-1 text-sm text-red-500"><%= section.errors[:title].to_sentence %></p>
      <% end %>
    </div>

    <div class="self-end">
      <button type="button"
              class="inline-flex items-center rounded-lg px-3 py-1.5 text-sm text-red-500 hover:bg-red-50 dark:hover:bg-red-900/40"
              data-action="nested-form#remove">
        X
      </button>
    </div>
  </div>

  <fieldset class="<%= "hidden" unless kind_key == "text" %>" <%= "disabled" unless kind_key == "text" %> data-section-kind-target="text">
    <label class="mb-2 block text-sm font-medium text-heading">Texto</label>
    <textarea class="<%= input_classes %> cursor-not-allowed placeholder:text-body-subtle"
              rows="4"
              readonly
              tabindex="-1"
              placeholder="El texto se carga al generar el informe."></textarea>
  </fieldset>

  <fieldset class="<%= "hidden" unless kind_key == "images" %>" <%= "disabled" unless kind_key == "images" %> data-section-kind-target="images">
    <label class="mb-2 block text-sm font-medium text-heading">Imágenes</label>
    <input class="block w-full cursor-not-allowed rounded-lg border border-default bg-neutral-secondary-medium text-sm text-heading"
           type="file"
           accept="image/*"
           multiple
           disabled
           tabindex="-1">
    <p class="mt-1 text-sm text-body-subtle">Las imágenes se cargan al generar el informe.</p>
  </fieldset>

  <fieldset class="<%= "hidden" unless kind_key == "table" %>" <%= "disabled" unless kind_key == "table" %> data-section-kind-target="table">
    <%= f.simple_fields_for :table_section, table_section do |table_form| %>
      <%= table_form.hidden_field :id %>
      <div data-controller="table-grid">
        <div class="mb-3 flex flex-wrap gap-3">
          <div>
            <label class="mb-2 block text-sm font-medium text-heading">Filas</label>
            <input class="<%= input_classes %> w-24"
                   type="number"
                   min="1"
                   max="<%= TableSection::MAX_ROWS %>"
                   name="<%= table_form.object_name %>[row_count]"
                   value="<%= table_section.row_count || 1 %>"
                   data-table-grid-target="rows"
                   data-action="input->table-grid#rebuild">
          </div>
          <div>
            <label class="mb-2 block text-sm font-medium text-heading">Columnas</label>
            <input class="<%= input_classes %> w-24"
                   type="number"
                   min="1"
                   max="<%= TableSection::MAX_COLUMNS %>"
                   name="<%= table_form.object_name %>[column_count]"
                   value="<%= table_section.column_count || 1 %>"
                   data-table-grid-target="columns"
                   data-action="input->table-grid#rebuild">
          </div>
        </div>
        <% table_errors = table_section.errors[:row_count] + table_section.errors[:column_count] + table_section.errors[:base] %>
        <% if table_errors.any? %>
          <p class="mb-2 text-sm text-red-500">
            <%= table_errors.to_sentence %>
          </p>
        <% end %>

        <div class="overflow-x-auto" data-table-grid-target="body">
          <table class="w-full border-collapse text-sm">
            <thead>
              <tr>
                <th class="min-w-36 border border-default p-2 align-top">
                  <% label = table_section.ensure_label("corner", 0) %>
                  <%= table_form.simple_fields_for :table_labels, label do |label_form| %>
                    <%= render "table_label_fields", f: label_form, axis: "corner", position: 0 %>
                  <% end %>
                </th>
                <% (table_section.column_count || 1).to_i.times do |column| %>
                  <th class="min-w-36 border border-default p-2 align-top">
                    <% label = table_section.ensure_label("column", column) %>
                    <%= table_form.simple_fields_for :table_labels, label do |label_form| %>
                      <%= render "table_label_fields", f: label_form, axis: "column", position: column %>
                    <% end %>
                  </th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <% (table_section.row_count || 1).to_i.times do |row| %>
                <tr>
                  <th class="min-w-36 border border-default p-2 align-top">
                    <% label = table_section.ensure_label("row", row) %>
                    <%= table_form.simple_fields_for :table_labels, label do |label_form| %>
                      <%= render "table_label_fields", f: label_form, axis: "row", position: row %>
                    <% end %>
                  </th>
                  <% (table_section.column_count || 1).to_i.times do |column| %>
                    <td class="min-w-36 border border-default p-2 align-top">
                      <% cell = table_section.cell_at(row, column) || table_section.table_cells.build(row_index: row, column_index: column, value_type: "string") %>
                      <%= table_form.simple_fields_for :table_cells, cell do |cell_form| %>
                        <%= render "table_cell_fields", f: cell_form %>
                      <% end %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <template data-table-grid-target="cellTemplate">
          <%= table_form.simple_fields_for :table_cells, TableCell.new(value_type: "string"), child_index: "CELL_INDEX" do |cell_form| %>
            <%= render "table_cell_fields", f: cell_form, row_index: "__ROW__", column_index: "__COL__", menu_id: "__MENU__" %>
          <% end %>
        </template>

        <template data-table-grid-target="labelTemplate">
          <%= table_form.simple_fields_for :table_labels, TableLabel.new(label: ""), child_index: "LABEL_INDEX" do |label_form| %>
            <%= render "table_label_fields", f: label_form, axis: "__AXIS__", position: "__POSITION__" %>
          <% end %>
        </template>
      </div>
    <% end %>
  </fieldset>

  <fieldset class="<%= "hidden" unless kind_key == "list" %>" <%= "disabled" unless kind_key == "list" %> data-section-kind-target="list">
    <%= f.simple_fields_for :list_section, list_section do |list_form| %>
      <%= list_form.hidden_field :id %>
      <div data-controller="nested-form" data-nested-form-placeholder-value="NEW_LIST_ITEM">
        <div data-nested-form-target="container">
          <%= list_form.simple_fields_for :list_items do |item_form| %>
            <%= render "list_item_fields", f: item_form %>
          <% end %>
        </div>

        <template data-nested-form-target="template">
          <%= list_form.simple_fields_for :list_items, ListItem.new, child_index: "NEW_LIST_ITEM" do |item_form| %>
            <%= render "list_item_fields", f: item_form %>
          <% end %>
        </template>

        <button type="button"
                class="inline-flex items-center rounded-lg border border-default px-3 py-1.5 text-sm text-body hover:bg-neutral-tertiary"
                data-action="nested-form#add">
          <%= t("activerecord.attributes.report_template.add_item") %>
        </button>
      </div>
    <% end %>
  </fieldset>
  </div>
</div>
