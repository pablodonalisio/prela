<%# locals: (f:) %>
<div class="field-row mb-3 flex flex-wrap items-end gap-2" data-nested-form-target="item">
  <%= f.hidden_field :id %>
  <%= f.hidden_field :position %>
  <%= f.hidden_field :_destroy, value: "0" %>

  <div class="min-w-48 flex-1">
    <%= f.input :name,
                label: t("activerecord.attributes.report_template_task.name"),
                label_html: {class: "mb-2 block text-sm font-medium text-heading"},
                input_html: {class: "block w-full rounded-lg border border-default bg-neutral-secondary-medium p-2.5 text-sm text-heading"},
                wrapper: false,
                placeholder: "ej: Limpieza general" %>
  </div>

  <div class="self-end">
    <button type="button"
            class="inline-flex items-center rounded-lg px-3 py-1.5 text-sm text-red-500 hover:bg-red-50 dark:hover:bg-red-900/40"
            data-action="nested-form#remove">
      X
    </button>
  </div>
</div>
