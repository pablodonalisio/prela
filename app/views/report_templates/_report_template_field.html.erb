<% optimal_fields_section = %w[measurements room_specifications].include?(section) %>
<% input_classes = "block w-full rounded-lg border border-default bg-neutral-secondary-soft p-2.5 text-sm text-heading" %>
<%= turbo_frame_tag "field_#{field_key}", data: {sortable_fields_target: "item"} do %>
  <div class="field-row mb-3 flex flex-wrap items-start gap-2">
    <button type="button"
            class="drag-handle inline-flex cursor-grab items-center self-center px-1 text-body-subtle"
            draggable="true"
            tabindex="-1"
            aria-label="<%= t("activerecord.attributes.report_template.reorder_field") %>"
            data-action="dragstart->sortable-fields#dragStart dragend->sortable-fields#dragEnd">
      <%= icon(:grip) %>
    </button>
    <input type="hidden"
           name="report_template[<%= section %>][<%= field_key %>][position]"
           value="<%= field_data["position"] %>"
           data-sortable-fields-position>
    <div class="min-w-40 flex-1">
      <label class="mb-2 block text-sm font-medium text-heading">Nombre del campo</label>
      <input type="text"
             class="field-name <%= input_classes %> <%= 'border-red-500' if report_template.errors.key?(section.to_sym) && field_data['name'].blank? %>"
             placeholder="ej: Tensión L1, Temperatura"
             value="<%= field_data['name'] %>"
             name="report_template[<%= section %>][<%= field_key %>][name]">
      <% if report_template.errors.key?(section.to_sym) && field_data["name"].blank? %>
        <div class="text-sm text-red-500">El nombre del campo no puede estar vacío.</div>
      <% end %>
    </div>
    <div class="min-w-32 flex-1">
      <label class="mb-2 block text-sm font-medium text-heading">Tipo de dato</label>
      <select class="field-type <%= input_classes %>" name="report_template[<%= section %>][<%= field_key %>][type]">
        <% ReportTemplate::FIELD_TYPES.each do |type| %>
          <option value="<%= type %>" <%= "selected" if field_data["type"] == type %>>
            <%= t("activerecord.attributes.equipment_kind.field_types.#{type}") %>
          </option>
        <% end %>
      </select>
    </div>
    <% if optimal_fields_section %>
      <div class="min-w-32">
        <label class="mb-2 block text-sm font-medium text-heading"><%= t("activerecord.attributes.report_template.optimal_value") %></label>
        <input type="text"
               class="<%= input_classes %>"
               placeholder="ej: 220 o 220-240"
               value="<%= field_data['optimal_value'] %>"
               name="report_template[<%= section %>][<%= field_key %>][optimal_value]">
      </div>
      <div class="min-w-24">
        <label class="mb-2 block text-sm font-medium text-heading"><%= t("activerecord.attributes.report_template.units") %></label>
        <input type="text"
               class="<%= input_classes %>"
               placeholder="ej: V, °C"
               value="<%= field_data['units'] %>"
               name="report_template[<%= section %>][<%= field_key %>][units]">
      </div>
    <% end %>
    <div class="self-end">
      <%= link_to "X",
                  remove_field_report_templates_path(field_key: field_key),
                  class: "inline-flex items-center rounded-lg px-3 py-1.5 text-sm text-red-500 hover:bg-red-50 dark:hover:bg-red-900/40",
                  data: {
                    turbo_stream: true,
                    turbo_confirm: "¿Eliminar este campo?"
                  } %>
    </div>
  </div>
<% end %>
