<%= turbo_frame_tag report_template, class: "col-sm-6 col-xl-4" do %>
  <div class="card border-secondary bg-primary bg-opacity-10 bg-gradient h-100">
    <div class="card-body">
      <h5 class="card-title text-center"><%= report_template.name %></h5>

      <% first_section = true %>
      <% ReportTemplate::SECTIONS.each do |section| %>
        <% fields = report_template.public_send(section) %>
        <% next if fields.blank? %>

        <h6 class="card-subtitle mb-2 text-muted <%= "mt-3" unless first_section %>">
          <%= t("activerecord.attributes.report_template.sections.#{section}") %>
        </h6>
        <%= render "field_list", fields: fields %>
        <% first_section = false %>
      <% end %>

      <% if report_template.active_sections.empty? %>
        <p class="text-muted small text-center mb-0">Sin secciones definidas.</p>
      <% end %>
    </div>

    <% if current_user.admin? %>
      <div class="card-footer bg-transparent border-top-0 d-flex flex-column gap-2">
        <%= link_to "Editar", edit_report_template_path(report_template), class: "btn btn-primary w-100", data: { turbo_frame: "remote_modal" } %>
        <%= button_to "Eliminar", report_template_path(report_template), method: :delete, form: { data: { turbo_confirm: "¿Seguro que querés borrar esta plantilla de informe?" } }, class: "btn btn-danger w-100" %>
      </div>
    <% end %>
  </div>
<% end %>
