<%= turbo_frame_tag report_template do %>
  <div class="rounded-xl border border-default bg-neutral-primary p-4">
    <div class="flex flex-col items-start gap-3 md:flex-row md:items-center">
      <div class="min-w-0 flex-1">
        <h5 class="mb-2 font-semibold text-heading"><%= report_template.name %></h5>

        <div class="flex flex-wrap gap-2">
          <% if report_template.active_sections.any? %>
            <% report_template.active_sections.each do |section| %>
              <span class="rounded-full bg-brand-soft px-2.5 py-0.5 text-xs font-medium text-fg-brand">
                <%= t("activerecord.attributes.report_template.sections.#{section}") %>
              </span>
            <% end %>
          <% else %>
            <span class="rounded-full bg-neutral-tertiary px-2.5 py-0.5 text-xs font-medium text-body">Sin secciones</span>
          <% end %>

          <span class="rounded-full bg-neutral-tertiary px-2.5 py-0.5 text-xs font-medium text-body">
            <%= report_template.location_equipments_count %>
            <%= report_template.location_equipments_count == 1 ? "activo" : "activos" %> usándolo
          </span>
        </div>
      </div>

      <% if current_user.admin? %>
        <div class="shrink-0 self-end md:self-center">
          <%= render "shared/dropdown" do %>
            <%= render "shared/button_box",
                       edit_path: edit_report_template_path(report_template),
                       delete_path: report_template_path(report_template),
                       confirm: "¿Seguro que querés borrar esta plantilla de informe?" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
