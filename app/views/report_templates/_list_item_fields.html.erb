<%# locals: (f:) %>
<div class="field-row mb-3 flex flex-wrap items-center gap-2" data-nested-form-target="item">
  <%= f.hidden_field :id %>
  <%= f.hidden_field :position %>
  <%= f.hidden_field :_destroy, value: "0" %>

  <div class="flex min-w-48 flex-1 items-center gap-2">
    <%= f.label :name, t("activerecord.attributes.list_item.name"), class: "shrink-0 whitespace-nowrap text-sm font-medium text-heading" %>
    <%= f.input_field :name,
                      class: "block min-w-0 flex-1 rounded-lg border border-default bg-neutral-secondary-medium p-2.5 text-sm text-heading",
                      placeholder: "ej: Limpieza general" %>
  </div>

  <div>
    <button type="button"
            class="inline-flex items-center rounded-lg px-3 py-1.5 text-sm text-red-500 hover:bg-red-50 dark:hover:bg-red-900/40"
            data-action="nested-form#remove">
      X
    </button>
  </div>
</div>
