<%= content_tag :tr, id: dom_id(activity), class: "border-t border-default" do %>
  <td class="px-4 py-3 align-middle">
    <p class="m-0 text-heading"><%= activity.description.capitalize %></p>
    <p class="m-0 text-xs text-body-subtle">Fecha: <%= activity.date.strftime("%d/%m/%Y") %></p>
  </td>
  <td class="px-4 py-3 align-middle">
    <div class="flex items-center gap-1">
      <% if activity.document.attached? %>
        <%= link_to location_equipment_activity_path(location_equipment, activity),
                    class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-neutral-tertiary hover:text-heading",
                    data: {turbo_frame: "remote_modal"},
                    aria: {label: "Ver"} do %>
          <%= icon(:file) %>
        <% end %>
      <% end %>
      <% if current_user.admin? || current_user.editor? %>
        <%= link_to edit_location_equipment_activity_path(location_equipment, activity),
                    class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-neutral-tertiary hover:text-heading",
                    data: {turbo_frame: "remote_modal"},
                    aria: {label: "Editar"} do %>
          <%= icon(:edit) %>
        <% end %>
        <%= button_to location_equipment_activity_path(location_equipment, activity),
                      method: :delete,
                      class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-red-100 hover:text-red-700 dark:hover:bg-red-900/40",
                      form: {data: {turbo_confirm: "¿Estas seguro?"}},
                      aria: {label: "Eliminar"} do %>
          <%= icon(:trash) %>
        <% end %>
      <% end %>
    </div>
  </td>
<% end %>
