<%= simple_form_for [location_equipment, activity] do |f| %>
  <%= render "shared/datetime_picker",
             form: f,
             value: activity.date || Time.current,
             disabled: !current_user.admin?,
             max: Date.new(Date.current.year, 12, 31) %>
  <%= f.input :description, label: "Descripción" %>

  <div class="mb-5 rounded-lg border border-default p-4">
    <h4 class="mb-3 text-sm font-medium text-heading">Documento</h4>
    <% document = activity.new_record? ? nil : activity.document %>
    <%= render "shared/file_upload", file: document,
                                              form: f,
                                              resize: [nil, 250],
                                              file_field: :document,
                                              new_label: "Nuevo documento",
                                              accepted_formats: "image/jpeg, image/jpg, image/png, application/pdf",
                                              multiple: false %>
  </div>

  <%= f.button :submit, "Aceptar" %>
<% end %>
