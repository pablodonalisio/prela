<%= turbo_frame_tag "main_content" do %>
  <%= render "shared/section_nav", active: "equipment" %>

  <%= render "shared/content_header", title: "Equipos" do %>
    <% if policy(Equipment).create? %>
      <%= render "shared/button_link", text: "Agregar", path: new_equipment_path %>
    <% end %>
  <% end %>

  <%= render "shared/items", collection: @equipment, pagy: @pagy %>
<% end %>
