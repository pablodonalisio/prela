<p class="flex flex-wrap items-center gap-2">
  <span class="rounded-md bg-brand-soft px-2 py-0.5 text-sm font-medium text-fg-brand">
    Tipo de activo
  </span>
  <span class="text-heading"><%= equipment.equipment_kind&.name || "—" %></span>
</p>
<p class="flex flex-wrap items-center gap-2">
  <span class="rounded-md bg-brand-soft px-2 py-0.5 text-sm font-medium text-fg-brand">
    Nombre
  </span>
  <span class="text-heading"><%= equipment.name %></span>
</p>
<p class="flex flex-wrap items-center gap-2">
  <span class="rounded-md bg-brand-soft px-2 py-0.5 text-sm font-medium text-fg-brand">
    <%= Equipment.human_attribute_name(:brand) %>
  </span>
  <span class="text-heading"><%= equipment.brand.presence || "—" %></span>
</p>
<p class="flex flex-wrap items-center gap-2">
  <span class="rounded-md bg-brand-soft px-2 py-0.5 text-sm font-medium text-fg-brand">
    <%= Equipment.human_attribute_name(:model) %>
  </span>
  <span class="text-heading"><%= equipment.model.presence || "—" %></span>
</p>
<% equipment.equipment_kind&.generic_fields&.each do |key, definition| %>
  <% value = equipment.field_values[key] %>
  <p class="flex flex-wrap items-center gap-2">
    <span class="rounded-md bg-brand-soft px-2 py-0.5 text-sm font-medium text-fg-brand">
      <%= definition["name"] %>
    </span>
    <span class="text-heading">
      <% if definition["type"] == "boolean" %>
        <%= value ? "Si" : "No" %>
      <% else %>
        <%= value.presence || "—" %>
      <% end %>
    </span>
  </p>
<% end %>
