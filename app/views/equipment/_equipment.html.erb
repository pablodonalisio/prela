<%= render "shared/content_header", title: "#{@equipment.name.upcase}" do %>
  <%= render "shared/dropdown" do %>
    <%= render "shared/button_box", edit_path: edit_equipment_path(@equipment),
                                            delete_path: equipment_path(@equipment),
                                            confirm: "¿Seguro querés borrar el Equipo?" %>
  <% end %>
<% end %>

<div class="space-y-3 p-4 md:px-6">
  <%= render "field_values", equipment: equipment %>
</div>
