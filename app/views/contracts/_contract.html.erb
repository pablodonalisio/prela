<%= content_tag :tr, id: dom_id(contract), class: "border-t border-default" do %>
  <td class="px-3 py-3 align-middle font-medium text-heading"><%= contract.name %></td>
  <td class="px-3 py-3 align-middle">
    <% if contract.file.attached? %>
      <%= link_to contract.file.filename.to_s,
                  rails_blob_path(contract.file, disposition: "attachment"),
                  class: "font-medium text-fg-brand hover:underline",
                  data: {turbo: false} %>
    <% else %>
      <span class="text-body-subtle">—</span>
    <% end %>
  </td>
  <td class="px-3 py-3 align-middle text-body"><%= contract.starts_on.strftime("%d/%m/%Y") %></td>
  <td class="px-3 py-3 align-middle text-body"><%= contract.ends_on.strftime("%d/%m/%Y") %></td>
  <td class="px-3 py-3 align-middle">
    <% if policy(contract).update? %>
      <div class="flex items-center justify-end gap-1">
        <%= link_to [:edit, client, contract],
                    class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-neutral-tertiary hover:text-heading",
                    data: {turbo_frame: "remote_modal"},
                    aria: {label: "Editar"} do %>
          <%= icon(:edit) %>
        <% end %>
        <%= button_to [client, contract],
                      method: :delete,
                      class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-red-100 hover:text-red-700 dark:hover:bg-red-900/40",
                      form: {data: {turbo_confirm: "¿Seguro querés borrar el contrato?"}},
                      aria: {label: "Eliminar"} do %>
          <%= icon(:trash) %>
        <% end %>
      </div>
    <% end %>
  </td>
<% end %>
