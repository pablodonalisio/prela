<% supply = equipment_supply.supply %>
<% replacements = supply.replacement_supplies %>
<div class="rounded-xl border border-default bg-neutral-primary p-4">
  <div class="flex flex-col items-start gap-3 md:flex-row md:items-center">
    <% if supply.avatar.attached? %>
      <%= image_tag supply.avatar.variant(resize_to_limit: [160, 160]),
                    alt: "Foto de #{supply.name}",
                    class: "h-20 w-20 shrink-0 rounded-lg bg-neutral-secondary-medium object-cover" %>
    <% else %>
      <%= image_tag "placeholder-img.jpeg",
                    alt: "Foto de #{supply.name}",
                    class: "h-20 w-20 shrink-0 rounded-lg bg-neutral-secondary-medium object-cover" %>
    <% end %>

    <div class="min-w-0 flex-1">
      <h5 class="font-semibold text-heading"><%= supply.name %></h5>
      <p class="mt-1 text-sm text-body">Cantidad: <%= equipment_supply.quantity %></p>
      <% if replacements.any? %>
        <p class="mt-2 text-sm text-body">Referencias cruzadas: <%= replacements.map(&:name).join(", ") %></p>
      <% end %>
    </div>

    <% if policy(equipment_supply).update? %>
      <div class="shrink-0 self-end md:self-center">
        <%= render "shared/dropdown" do %>
          <%= render "shared/button_box",
                     edit_path: edit_equipment_supply_path(equipment_supply),
                     delete_path: equipment_supply_path(equipment_supply),
                     confirm: "¿Seguro querés quitar este insumo del equipo?" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
