<% location_equipment = service_occurrence.location_equipment %>
<% extra_class = local_assigns.fetch(:class, "ms-2") %>
<% action_class = "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-neutral-tertiary hover:text-heading #{extra_class}" %>

<% if current_user.admin? || current_user.editor? %>
  <% if service_occurrence.open? %>
    <%= link_to complete_location_equipment_service_occurrence_path(location_equipment, service_occurrence),
                class: action_class,
                data: {turbo_frame: "remote_modal"},
                title: "Registrar servicio",
                aria: {label: "Registrar servicio"} do %>
      <%= icon(:check) %>
    <% end %>

    <% if service_occurrence.pending? %>
      <%= link_to edit_location_equipment_service_occurrence_path(location_equipment, service_occurrence, intent: "due_on"),
                  class: action_class,
                  data: {turbo_frame: "remote_modal"},
                  title: "Editar vencimiento",
                  aria: {label: "Editar vencimiento"} do %>
        <%= icon(:edit) %>
      <% end %>
      <%= link_to edit_location_equipment_service_occurrence_path(location_equipment, service_occurrence, intent: "suspend"),
                  class: action_class,
                  data: {turbo_frame: "remote_modal"},
                  title: "Suspender",
                  aria: {label: "Suspender"} do %>
        <%= icon(:pause) %>
      <% end %>
      <%= link_to edit_location_equipment_service_occurrence_path(location_equipment, service_occurrence, intent: "schedule"),
                  class: action_class,
                  data: {turbo_frame: "remote_modal"},
                  title: "Programar",
                  aria: {label: "Programar"} do %>
        <%= icon(:calendar_plus) %>
      <% end %>
    <% elsif service_occurrence.suspended? %>
      <%= link_to edit_location_equipment_service_occurrence_path(location_equipment, service_occurrence, intent: "schedule"),
                  class: action_class,
                  data: {turbo_frame: "remote_modal"},
                  title: "Programar",
                  aria: {label: "Programar"} do %>
        <%= icon(:calendar_plus) %>
      <% end %>
      <%= link_to edit_location_equipment_service_occurrence_path(location_equipment, service_occurrence, intent: "revert"),
                  class: action_class,
                  data: {turbo_frame: "remote_modal"},
                  title: "Volver a pendiente",
                  aria: {label: "Volver a pendiente"} do %>
        <%= icon(:undo) %>
      <% end %>
    <% elsif service_occurrence.scheduled? %>
      <%= link_to edit_location_equipment_service_occurrence_path(location_equipment, service_occurrence, intent: "revert"),
                  class: action_class,
                  data: {turbo_frame: "remote_modal"},
                  title: "Volver a pendiente",
                  aria: {label: "Volver a pendiente"} do %>
        <%= icon(:undo) %>
      <% end %>
    <% end %>
  <% elsif service_occurrence.completed? %>
    <%= link_to edit_location_equipment_service_occurrence_path(location_equipment, service_occurrence, intent: "completed"),
                class: action_class,
                data: {turbo_frame: "remote_modal"},
                title: "Editar servicio",
                aria: {label: "Editar servicio"} do %>
      <%= icon(:edit) %>
    <% end %>
  <% elsif service_occurrence.cancelled? %>
    <%= link_to edit_location_equipment_service_occurrence_path(location_equipment, service_occurrence, intent: "notes"),
                class: action_class,
                data: {turbo_frame: "remote_modal"},
                title: "Editar notas",
                aria: {label: "Editar notas"} do %>
      <%= icon(:edit) %>
    <% end %>
  <% end %>
<% end %>
