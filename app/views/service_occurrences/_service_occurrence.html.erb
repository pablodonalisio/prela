<p class="card-text m-0 text-truncate">
  <small class="text-body-secondary">
    <label><%= service_occurrence.service_kind.name %>: </label>
    <%= turbo_frame_tag service_occurrence do %>
      <span class="<%= service_date_color(service_occurrence.due_on) %>">
        <%= service_occurrence.due_on.strftime("%d/%m/%Y") %>
      </span>
      <% if current_user.admin? || current_user.editor? %>
        <%= link_to complete_location_equipment_service_occurrence_path(service_occurrence.location_equipment, service_occurrence),
                    class: "ms-2",
                    data: {turbo_frame: "remote_modal"},
                    title: "Registrar servicio" do %>
          <i class="fas fa-check"></i>
        <% end %>
        <%= link_to edit_location_equipment_service_occurrence_path(service_occurrence.location_equipment, service_occurrence),
                    class: "ms-2",
                    data: {turbo_frame: "remote_modal"},
                    title: "Editar vencimiento" do %>
          <i class="fas fa-edit"></i>
        <% end %>
      <% end %>
    <% end %>
  </small>
</p>
