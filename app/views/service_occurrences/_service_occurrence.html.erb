<p class="card-text m-0">
  <small class="text-body-secondary">
    <label><%= service_occurrence.service_kind.name %>: </label>
    <%= turbo_frame_tag service_occurrence do %>
      <span class="<%= service_date_color(service_occurrence.due_on) %>">
        <%= service_occurrence.due_on.strftime("%d/%m/%Y") %>
      </span>

      <% if service_occurrence.suspended? %>
        <span class="badge bg-secondary ms-1"><%= service_occurrence.status_label %></span>
      <% elsif service_occurrence.scheduled? %>
        <span class="badge bg-info text-dark ms-1"><%= service_occurrence.status_label %></span>
        <span class="ms-1">(<%= service_occurrence.planned_on.strftime("%d/%m/%Y") %>)</span>
      <% end %>

      <% if service_occurrence.notes.present? && (service_occurrence.suspended? || service_occurrence.scheduled?) %>
        <span class="ms-1" title="<%= service_occurrence.notes %>">
          <i class="fas fa-sticky-note"></i>
        </span>
      <% end %>

      <%= render "service_occurrences/actions", service_occurrence: service_occurrence %>
    <% end %>
  </small>
</p>
