<%= turbo_frame_tag @service_occurrence do %>
  <%= render "shared/remote_modal", title: "Registrar servicio — #{@service_occurrence.service_kind.name}" do %>
    <%= simple_form_for [@location_equipment, @service_occurrence],
                        url: complete_location_equipment_service_occurrence_path(@location_equipment, @service_occurrence),
                        method: :post,
                        html: {multipart: true} do |f| %>
      <%= f.input :completed_on,
                  label: "Fecha de realización",
                  as: :date,
                  html5: true,
                  input_html: {value: Date.current} %>

      <div class="mb-5 rounded-lg border border-default p-4">
        <h4 class="mb-3 text-sm font-medium text-heading">Documento</h4>
        <%= render "shared/file_upload", file: nil,
                                                  form: f,
                                                  resize: [nil, 250],
                                                  file_field: :document,
                                                  new_label: "Nuevo documento",
                                                  accepted_formats: "image/jpeg, image/jpg, image/png, application/pdf",
                                                  multiple: false %>
      </div>

      <%= f.button :submit, "Registrar servicio" %>
    <% end %>
  <% end %>
<% end %>
