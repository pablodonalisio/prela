<%= simple_form_for [location_equipment, service_occurrence],
                    html: (intent == "completed") ? {multipart: true} : {} do |f| %>
  <%= hidden_field_tag :intent, intent %>

  <% case intent %>
  <% when "suspend" %>
    <%= f.hidden_field :status, value: "suspended" %>
    <%= f.input :notes,
                label: "Motivo (opcional)",
                as: :text,
                input_html: {rows: 3} %>
    <%= f.submit "Suspender", class: "rounded-lg bg-yellow-500 px-4 py-2 text-sm font-medium text-white hover:bg-yellow-600" %>

  <% when "schedule" %>
    <%= f.hidden_field :status, value: "scheduled" %>
    <div data-controller="schedule-range"
         data-action="change->schedule-range#syncFinishMin">
      <%= render "shared/datetime_picker",
                 form: f,
                 field: :planned_on_init,
                 label: "Inicio programado",
                 value: service_occurrence.planned_on_init || Time.current,
                 min: Date.current,
                 required: true,
                 data: {schedule_range_target: "init"} %>
      <%= render "shared/datetime_picker",
                 form: f,
                 field: :planned_on_finish,
                 label: "Fin programado",
                 value: service_occurrence.planned_on_finish,
                 blank: true,
                 min: (service_occurrence.planned_on_init || Time.current).to_date,
                 required: true,
                 data: {schedule_range_target: "finish"} %>
    </div>
    <% technicians = User.technician.order(:email) %>
    <% dropdown_id = "technician-dropdown-#{service_occurrence.id}" %>
    <div class="relative mb-5" data-controller="dropdown-search">
      <p class="mb-2 text-sm font-medium text-heading">Técnicos</p>
      <% if technicians.any? %>
        <button type="button"
                class="inline-flex w-full items-center justify-between rounded-lg border border-default bg-neutral-secondary-medium p-2.5 text-sm text-heading hover:bg-neutral-tertiary focus:border-brand focus:ring-brand"
                data-dropdown-search-target="button"
                aria-haspopup="listbox">
          <span class="truncate text-body-subtle" data-dropdown-search-target="label">Técnicos</span>
          <%= icon(:chevron_down, class: "ms-2 text-xs text-body-subtle") %>
        </button>

        <div id="<%= dropdown_id %>"
             class="z-50 hidden rounded-base border border-default bg-neutral-secondary-medium shadow-sm"
             data-dropdown-search-target="menu">
          <div class="p-3">
            <label for="<%= dropdown_id %>-search" class="sr-only">Buscar técnico</label>
            <div class="relative">
              <div class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3">
                <svg class="h-4 w-4 text-body-subtle" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
                  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
                </svg>
              </div>
              <input type="search"
                     id="<%= dropdown_id %>-search"
                     class="block w-full rounded-lg border border-default bg-neutral-primary p-2 ps-10 text-sm text-heading placeholder:text-body-subtle focus:border-brand focus:ring-brand"
                     placeholder="Buscar técnico"
                     autocomplete="off"
                     data-dropdown-search-target="search">
            </div>
          </div>
          <ul class="h-48 overflow-y-auto px-3 pb-3 text-sm text-heading" aria-labelledby="<%= dropdown_id %>">
            <% technicians.each do |technician| %>
              <li data-dropdown-search-target="item" data-label="<%= technician.display_name %>">
                <div class="flex items-center rounded-sm ps-2 hover:bg-neutral-tertiary-medium">
                  <%= check_box_tag "service_occurrence[technician_ids][]",
                                    technician.id,
                                    service_occurrence.technician_ids.include?(technician.id),
                                    id: "technician_#{service_occurrence.id}_#{technician.id}",
                                    class: "h-4 w-4 rounded border-default bg-neutral-secondary-medium text-brand focus:ring-brand" %>
                  <%= label_tag "technician_#{service_occurrence.id}_#{technician.id}",
                                technician.display_name,
                                class: "ms-2 w-full rounded-sm py-2 text-sm font-medium text-heading" %>
                </div>
              </li>
            <% end %>
          </ul>
          <p class="hidden px-3 pb-3 text-sm text-body-subtle" data-dropdown-search-target="empty">Sin resultados</p>
        </div>
      <% else %>
        <p class="text-sm text-body-subtle">No hay técnicos</p>
      <% end %>
      <% if service_occurrence.errors[:technicians].any? %>
        <p class="mt-2 text-sm text-fg-danger"><%= service_occurrence.errors.full_messages_for(:technicians).to_sentence %></p>
      <% end %>
    </div>
    <%= f.input :notes,
                label: "Notas (opcional)",
                as: :text,
                input_html: {rows: 3} %>
    <%= f.button :submit, "Programar" %>

  <% when "revert" %>
    <%= f.hidden_field :status, value: "pending" %>
    <p class="mb-5 text-sm text-body">El servicio volverá a estado pendiente y se quitarán el inicio y el fin programados.</p>
    <%= f.input :notes,
                label: "Notas (opcional)",
                as: :text,
                input_html: {rows: 3} %>
    <%= f.submit "Volver a pendiente", class: "rounded-lg border border-default bg-neutral-primary px-4 py-2 text-sm font-medium text-body hover:bg-neutral-tertiary" %>

  <% when "completed" %>
    <%= f.input :completed_on,
                label: "Fecha de realización",
                as: :date,
                html5: true,
                input_html: {value: service_occurrence.completed_on || Date.current} %>
    <%= f.input :notes,
                label: "Notas (opcional)",
                as: :text,
                input_html: {rows: 3} %>

    <div class="mb-5 rounded-lg border border-default p-4">
      <h4 class="mb-3 text-sm font-medium text-heading">Documento</h4>
      <%= render "shared/file_upload", file: service_occurrence.document.attached? ? service_occurrence.document : nil,
                                                form: f,
                                                resize: [nil, 250],
                                                file_field: :document,
                                                new_label: "Nuevo documento",
                                                accepted_formats: "image/jpeg, image/jpg, image/png, application/pdf",
                                                multiple: false %>
    </div>

    <%= f.button :submit, "Guardar" %>

  <% when "priority" %>
    <%= f.input :priority,
                label: "Prioridad",
                collection: ServiceOccurrence.priority_options,
                include_blank: false %>
    <%= f.button :submit, "Aceptar" %>

  <% when "notes" %>
    <%= f.input :notes,
                label: "Notas",
                as: :text,
                input_html: {rows: 3} %>
    <%= f.button :submit, "Guardar" %>

  <% else %>
    <%= f.input :due_on,
                label: "Próximo vencimiento",
                as: :date,
                html5: true %>
    <%= f.button :submit, "Aceptar" %>
  <% end %>
<% end %>
