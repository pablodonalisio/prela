<%= turbo_frame_tag "main_content" do %>
  <% if params[:open] == "new" && policy(Supply).new? %>
    <div hidden
         data-controller="open-remote-modal"
         data-open-remote-modal-url-value="<%= new_supply_path %>"></div>
  <% end %>

  <%= render "shared/insumos_nav", active: "supplies" %>

  <%= render "shared/content_header", title: "Lista" do %>
    <% if policy(Supply).create? %>
      <%= render "shared/button_link", text: "Agregar", path: new_supply_path %>
    <% end %>
  <% end %>

  <div class="mx-4 mt-4 md:mx-6">
    <%= render "filter_form" %>
  </div>

  <%= render "list" %>
<% end %>
