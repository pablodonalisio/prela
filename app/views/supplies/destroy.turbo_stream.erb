<%= turbo_stream.update "flash" do %>
  <%= render "layouts/flash" %>
<% end %>

<%= turbo_stream.remove @supply %>
<% if policy_scope(Supply).none? %>
  <%= turbo_stream.append "supplies" do %>
    <%= render "shared/empty_collection",
               id: "supplies_empty",
               message: "No hay insumos todavía.",
               action_text: policy(Supply).create? ? "Agregar" : nil,
               action_path: policy(Supply).create? ? new_supply_path : nil %>
  <% end %>
<% end %>
