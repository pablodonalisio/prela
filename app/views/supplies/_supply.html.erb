<%= turbo_frame_tag supply do %>
  <div class="rounded-xl border border-default bg-neutral-primary p-4">
    <div class="flex flex-col items-start gap-3 md:flex-row md:items-center">
      <% if supply.avatar.attached? %>
        <%= image_tag supply.avatar.variant(resize_to_limit: [160, 160]),
                      alt: "Foto de #{supply.name}",
                      class: "h-20 w-20 shrink-0 rounded-lg bg-neutral-secondary-medium object-cover" %>
      <% else %>
        <%= image_tag "placeholder-img.jpeg",
                      alt: "Foto de #{supply.name}",
                      class: "h-20 w-20 shrink-0 rounded-lg bg-neutral-secondary-medium object-cover" %>
      <% end %>

      <div class="min-w-0 flex-1">
        <h5 class="mb-1 font-semibold text-heading"><%= supply.name %></h5>

        <div class="flex flex-wrap gap-2">
          <span class="inline-flex items-center rounded-full bg-brand-soft px-2.5 py-0.5 text-xs font-medium text-fg-brand">
            <%= supply.supply_kind.name %>
          </span>
        </div>

        <% if supply.description.present? %>
          <p class="mt-2 line-clamp-3 text-sm text-body"><%= supply.description %></p>
        <% end %>

        <% if supply.reference_url.present? %>
          <%= link_to "Referencia", supply.reference_url,
                      target: "_blank",
                      rel: "noopener noreferrer",
                      class: "mt-2 inline-block text-sm text-fg-brand hover:underline" %>
        <% end %>

        <% replacements = supply.replacement_supplies %>
        <% if replacements.any? %>
          <p class="mt-2 text-sm text-body">Referencias cruzadas: <%= replacements.map(&:name).join(", ") %></p>
        <% end %>
      </div>

      <% if policy(supply).update? %>
        <div class="shrink-0 self-end md:self-center">
          <%= render "shared/dropdown" do %>
            <%= render "shared/button_box",
                       edit_path: edit_supply_path(supply),
                       delete_path: supply_path(supply),
                       confirm: "¿Seguro que querés borrar este insumo?" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
