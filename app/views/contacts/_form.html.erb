<% checkbox_classes = "h-4 w-4 rounded border-default bg-neutral-secondary-soft text-brand focus:ring-brand" %>

<%= simple_form_for [client, contact],
                    html: {data: {controller: "contact-distance"}} do |f| %>
  <%= f.input :name, label: "Nombre" %>
  <%= f.input :job_position, label: "Puesto" %>
  <%= f.input :work_area, label: "Área de trabajo" %>
  <% kept_locations = client.locations.kept.order(:name) %>
  <% if kept_locations.any? %>
    <div class="mb-4">
      <p class="mb-2 text-sm font-medium text-heading">Sedes</p>
      <%= f.collection_check_boxes :location_ids, kept_locations, :id, :name do |b| %>
        <div class="mb-2 flex items-center">
          <%= b.check_box class: checkbox_classes %>
          <%= b.label class: "ms-2 text-sm text-heading" %>
        </div>
      <% end %>
    </div>
  <% end %>
  <%= f.input :reports_to_id,
              collection: manager_options_for(client, contact),
              label: "Reporta a",
              include_blank: "Sin superior",
              input_html: {
                data: {
                  contact_distance_target: "reportsTo",
                  action: "change->contact-distance#syncDistance"
                }
              } %>
  <%= f.input :distance_above,
              label: "Niveles de distancia a su superior (para organigrama)",
              hint: "0 solo si no tiene superior (tope del organigrama). Con superior, mínimo 1. Mayor = más separación.",
              input_html: {
                min: 0,
                data: {contact_distance_target: "distanceAbove"}
              } %>
  <%= f.input :email, label: "Email" %>
  <%= f.input :phone, label: "Teléfono" %>
  <%= f.input :description, label: "Comentario", as: :text %>
  <%= f.button :submit, "Aceptar" %>
<% end %>
