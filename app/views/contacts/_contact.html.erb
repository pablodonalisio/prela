<%= content_tag :tr, id: dom_id(contact), class: "border-t border-default" do %>
  <td class="px-3 py-3 align-middle">
    <div class="font-medium text-heading"><%= contact.name %></div>
    <% if contact.description.present? %>
      <div class="max-w-72 truncate text-xs text-body-subtle"><%= contact.description %></div>
    <% end %>
  </td>
  <td class="px-3 py-3 align-middle text-body"><%= contact.job_position %></td>
  <td class="px-3 py-3 align-middle">
    <span class="inline-flex items-center rounded-full bg-neutral-tertiary px-2.5 py-0.5 text-xs font-medium text-body">
      <%= contact.work_area %>
    </span>
  </td>
  <td class="px-3 py-3 align-middle text-body-subtle">
    <% location_names = contact.locations.select(&:kept?).map(&:name) %>
    <%= location_names.any? ? location_names.join(", ") : "—" %>
  </td>
  <td class="px-3 py-3 align-middle">
    <% if contact.email.present? %>
      <%= mail_to contact.email, contact.email, class: "font-medium text-fg-brand hover:underline" %>
    <% else %>
      <span class="text-body-subtle">—</span>
    <% end %>
  </td>
  <td class="px-3 py-3 align-middle text-body-subtle">
    <%= contact.phone.presence || "—" %>
  </td>
  <td class="px-3 py-3 align-middle">
    <div class="flex items-center justify-end gap-1">
      <%= link_to [:edit, client, contact],
                  class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-neutral-tertiary hover:text-heading",
                  data: {turbo_frame: "remote_modal"},
                  aria: {label: "Editar"} do %>
        <%= icon(:edit) %>
      <% end %>
      <%= button_to [client, contact],
                    method: :delete,
                    class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-red-100 hover:text-red-700 dark:hover:bg-red-900/40",
                    form: {data: {turbo_confirm: "¿Seguro querés borrar el contacto?"}},
                    aria: {label: "Eliminar"} do %>
        <%= icon(:trash) %>
      <% end %>
    </div>
  </td>
<% end %>
