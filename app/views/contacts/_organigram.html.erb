<% roots = client.contacts.roots.includes(:locations, :direct_reports).order(:distance_above, :name) %>
<% if roots.any? %>
  <ul class="organigram-tree">
    <% roots.each do |contact| %>
      <%= render "contacts/organigram_node", contact: contact %>
    <% end %>
  </ul>
<% else %>
  <p class="text-sm text-body-subtle">Agregá contactos y asigná “Reporta a” para armar el organigrama.</p>
<% end %>
