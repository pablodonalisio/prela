<h2 class="mb-3 mt-4 text-lg font-semibold text-heading">Fecha</h2>
<%= render "shared/datetime_picker",
           form: f,
           value: report.date || Time.current,
           disabled: !current_user.admin?,
           min: Date.new(2016, 1, 1),
           max: Date.new(Date.current.year, 12, 31) %>

<% report_template = report.report_template || @all_templates&.first %>
<% if report_template %>
  <div data-controller="report-template-picker"
       data-report-template-picker-base-url-value="<%= template_fields_location_equipment_reports_path(location_equipment) %>"
       data-report-template-picker-report-id-value="<%= report.persisted? ? report.id : "" %>">

    <h2 class="mb-3 mt-4 text-lg font-semibold text-heading">Plantilla</h2>

    <% if @associated_templates&.any? %>
      <p class="text-sm text-body-subtle">Plantillas asociadas al equipo</p>
      <div class="mb-3 flex flex-wrap gap-2">
        <% @associated_templates.each do |template| %>
          <button type="button"
                  class="<%= report_template.id == template.id ? "rounded-lg bg-brand px-3 py-1.5 text-sm font-medium text-white hover:bg-brand-strong" : "rounded-lg border border-brand px-3 py-1.5 text-sm text-fg-brand hover:bg-brand-soft" %>"
                  data-action="report-template-picker#selectAssociated"
                  data-report-template-picker-template-id-param="<%= template.id %>">
            <%= template.name %>
          </button>
        <% end %>
      </div>
    <% end %>

    <%= f.input :report_template_id,
                label: "Buscar plantilla",
                collection: @all_templates.map { |t| [t.name, t.id] },
                selected: report_template.id,
                include_blank: false,
                input_html: {
                  data: {
                    report_template_picker_target: "select",
                    action: "change->report-template-picker#reloadFields",
                    controller: "searchable-select"
                  }
                } %>

    <%= turbo_frame_tag "report_template_fields",
                        src: template_fields_location_equipment_reports_path(
                          location_equipment,
                          report_template_id: report_template.id,
                          report_id: (report.persisted? ? report.id : nil)
                        ),
                        data: { report_template_picker_target: "frame" } do %>
      <%= render "template_fields", report: report, report_template: report_template %>
    <% end %>
  </div>
<% else %>
  <p class="text-yellow-500">No hay plantillas de informe disponibles. Creá una desde Informes.</p>
<% end %>

<%= render "report_images", report: report, f: f %>

<% selectable_signatures = Signature.kept.order(:name).to_a %>
<% if report.persisted? %>
  <% selectable_signatures |= report.signatures.merge(Signature.discarded).order(:name).to_a %>
<% end %>
<% if selectable_signatures.any? %>
  <h2 class="mb-3 mt-4 text-lg font-semibold text-heading"><%= t("reports.template_report.signatures_section") %></h2>
  <div class="mb-3">
    <%= f.collection_check_boxes :signature_ids, selectable_signatures, :id, :name do |b| %>
      <div class="mb-2 flex items-center">
        <%= b.check_box class: "h-4 w-4 rounded border-default bg-neutral-secondary-soft text-brand focus:ring-brand" %>
        <%= b.label class: "ms-2 text-sm text-heading" do %>
          <%= b.text %>
          <span class="text-body-subtle">— <%= b.object.title %></span>
          <% if b.object.discarded? %>
            <span class="text-yellow-500">(eliminada del catálogo)</span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
