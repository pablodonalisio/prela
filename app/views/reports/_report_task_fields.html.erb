<%# locals: (f:, task: nil) %>
<div class="field-row mb-3 d-flex gap-2 align-items-center flex-wrap" data-nested-form-target="item">
  <%= f.hidden_field :id %>
  <%= f.hidden_field :position %>
  <%= f.hidden_field :_destroy, value: false %>

  <div class="form-check mb-0">
    <%= f.check_box :completed, class: "form-check-input" %>
    <%= f.label :completed, t("activerecord.attributes.report_task.completed"), class: "form-check-label visually-hidden" %>
  </div>

  <div class="flex-grow-1" style="min-width: 12rem;">
    <%= f.text_field :name,
                     class: "form-control",
                     placeholder: t("reports.template_report.task_placeholder") %>
  </div>

  <button type="button"
          class="btn btn-sm btn-outline-danger"
          data-action="nested-form#remove">
    X
  </button>
</div>
