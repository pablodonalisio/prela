<%= content_tag :tr, id: dom_id(report), class: "border-t border-default" do %>
  <td class="px-4 py-3"><%= report.date.strftime("%d/%m/%Y") %></td>
  <td class="px-4 py-3">
    <div class="flex items-center justify-evenly">
      <%= link_to location_equipment_report_path(location_equipment, report),
                  class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-neutral-tertiary hover:text-heading",
                  data: { turbo_frame: "remote_modal" } do %>
        <%= icon(:view) %>
      <% end %>
      <% if current_user.admin? || current_user.editor? %>
        <%= link_to edit_location_equipment_report_path(location_equipment, report),
                    class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-neutral-tertiary hover:text-heading",
                    data: { turbo_frame: "remote_modal" } do %>
          <%= icon(:edit) %>
        <% end %>
        <%= button_to location_equipment_report_path(location_equipment, report),
                      class: "inline-flex h-8 w-8 items-center justify-center rounded-lg text-body hover:bg-red-100 hover:text-red-700 dark:hover:bg-red-900/40",
                      form_class: "inline",
                      method: :delete,
                      form: { data: {turbo_confirm: "¿Estás seguro?"} } do %>
          <%= icon(:trash) %>
        <% end %>
      <% end %>
    </div>
  </td>
<% end %>
