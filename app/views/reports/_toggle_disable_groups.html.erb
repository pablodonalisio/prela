<div class="rounded-lg border border-default p-3 my-4">
  <p class="mb-2 text-sm font-medium text-heading"><%= group_name %></p>
  <div>
    <div class="mb-2 flex items-center">
      <%= render "toggle_disable_checkbox", attribute: attribute,
                                            form_group_id: form_group_id,
                                            label: toggle_disable_label %>
    </div>
    <div id="<%= form_group_id %>" class="mt-4">
      <%= yield %>
    </div>
  </div>
</div>
