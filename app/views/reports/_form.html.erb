<% autosave_form = report.new_record? && @report_mode != "template" %>
<%= simple_form_for [location_equipment, report], html: {
  data: autosave_form ? {auto_save_target: "form"} : {}
} do |f| %>
  <% if report.new_record? %>
    <div class="mb-4 border-b border-default">
      <ul class="-mb-px flex flex-wrap gap-1 text-sm font-medium">
        <li>
          <%= link_to "Clásico (PDF)",
                      new_location_equipment_report_path(location_equipment, report_mode: "legacy"),
                      class: "inline-block border-b-2 px-4 py-3 #{@report_mode == "legacy" ? "border-brand text-fg-brand" : "border-transparent text-body hover:border-default hover:text-heading"}",
                      data: { turbo_frame: dom_id(report) } %>
        </li>
        <li>
          <%= link_to "Plantilla",
                      new_location_equipment_report_path(location_equipment, report_mode: "template"),
                      class: "inline-block border-b-2 px-4 py-3 #{@report_mode == "template" ? "border-brand text-fg-brand" : "border-transparent text-body hover:border-default hover:text-heading"}",
                      data: { turbo_frame: dom_id(report) } %>
        </li>
        <li>
          <%= link_to "Subir archivo",
                      new_location_equipment_report_path(location_equipment, report_mode: "upload"),
                      class: "inline-block border-b-2 px-4 py-3 #{@report_mode == "upload" ? "border-brand text-fg-brand" : "border-transparent text-body hover:border-default hover:text-heading"}",
                      data: { turbo_frame: dom_id(report) } %>
        </li>
      </ul>
    </div>
  <% end %>

  <% if report.uploaded? || (@report_mode == "upload" && report.new_record?) %>
    <%= render "upload_form", f: f, report: report %>
  <% elsif report.template_based? || (@report_mode == "template" && report.new_record?) %>
    <%= render "template_form", f: f, report: report, location_equipment: location_equipment %>
  <% else %>
    <%= render "legacy_form", f: f, report: report, location_equipment: location_equipment %>
  <% end %>

  <%= f.button :submit, "Aceptar" %>
<% end %>
