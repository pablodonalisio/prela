<%= simple_form_for [location_equipment, report], html: {
  data: {
    auto_save_target: "form",
  }
} do |f| %>
  <% if report.new_record? %>
    <ul class="nav nav-tabs mb-4">
      <li class="nav-item">
        <%= link_to "Clásico (PDF)",
                    new_location_equipment_report_path(location_equipment, report_mode: "legacy"),
                    class: "nav-link #{"active" if @report_mode == "legacy"}",
                    data: { turbo_frame: dom_id(report) } %>
      </li>
      <li class="nav-item">
        <%= link_to "Plantilla",
                    new_location_equipment_report_path(location_equipment, report_mode: "template"),
                    class: "nav-link #{"active" if @report_mode == "template"}",
                    data: { turbo_frame: dom_id(report) } %>
      </li>
    </ul>
  <% end %>

  <% if report.template_based? || (@report_mode == "template" && report.new_record?) %>
    <%= render "template_form", f: f, report: report, location_equipment: location_equipment %>
  <% else %>
    <%= render "legacy_form", f: f, report: report, location_equipment: location_equipment %>
  <% end %>

  <%= f.button :submit, "Aceptar", class: "btn btn-success" %>
<% end %>
