<% report_template = local_assigns[:report_template] || report.report_template %>
<% sections = if report.sections.any?
     report.sections.sort_by { |section| section.position.to_i }
   elsif report_template
     report_template.sections.with_details.order(:position)
   else
     []
   end %>

<% sections.each do |section| %>
  <%= render "report_section_fields", section: section %>
<% end %>
