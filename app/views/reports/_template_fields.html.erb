<% report_template = local_assigns[:report_template] || report.report_template %>
<% return unless report_template %>

<% report_template.active_sections.each do |section| %>
  <h2 class="mt-3"><%= t("activerecord.attributes.report_template.sections.#{section}") %></h2>
  <%= render "shared/dynamic_field_inputs",
             field_definitions: report_template.fields_for(section),
             field_values: report.field_values_for(section),
             param_prefix: "report[field_values][#{section}]",
             id_prefix: "report_#{section}" %>
<% end %>

<%= render "report_tasks_fields", report: report %>
<%= render "report_comments_fields", report: report %>
