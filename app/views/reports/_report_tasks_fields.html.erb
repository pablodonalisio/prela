<%# locals: (report:) %>
<div class="mt-3" data-controller="nested-form">
  <h2 class="mb-3 mt-4 text-lg font-semibold text-heading"><%= t("reports.template_report.tasks_section") %></h2>
  <div class="mb-2 rounded-lg border border-default p-3">
    <div data-nested-form-target="container">
      <% report.report_tasks.each_with_index do |task, index| %>
        <% child_index = task.persisted? ? task.id : "new_#{index}" %>
        <%= fields_for "report[report_tasks_attributes][#{child_index}]", task do |task_form| %>
          <%= render "report_task_fields", f: task_form %>
        <% end %>
      <% end %>
    </div>

    <template data-nested-form-target="template">
      <%= fields_for "report[report_tasks_attributes][NEW_RECORD]", ReportTask.new do |task_form| %>
        <%= render "report_task_fields", f: task_form %>
      <% end %>
    </template>
  </div>

  <button type="button"
          class="inline-flex items-center rounded-lg border border-default px-3 py-1.5 text-sm text-body hover:bg-neutral-tertiary"
          data-action="nested-form#add">
    <%= t("reports.template_report.add_task") %>
  </button>
</div>
