<%# locals: (f:) %>
<div class="field-row mb-3 d-flex gap-2 align-items-start flex-wrap" data-nested-form-target="item">
  <%= f.hidden_field :id %>
  <%= f.hidden_field :position %>
  <%= f.hidden_field :_destroy, value: false %>

  <div class="flex-grow-1" style="min-width: 12rem;">
    <%= f.text_area :description,
                    class: "form-control",
                    rows: 2,
                    placeholder: t("reports.template_report.comment_placeholder") %>
  </div>

  <button type="button"
          class="btn btn-sm btn-outline-danger align-self-start"
          data-action="nested-form#remove">
    X
  </button>
</div>
