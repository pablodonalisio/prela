<%# locals: (f:) %>
<div class="field-row mb-3 flex flex-wrap items-start gap-2" data-nested-form-target="item">
  <%= f.hidden_field :id %>
  <%= f.hidden_field :position %>
  <%= f.hidden_field :_destroy, value: false %>

  <div class="min-w-48 flex-1">
    <%= f.text_area :description,
                    class: "block w-full rounded-lg border border-default bg-neutral-secondary-medium p-2.5 text-sm text-heading",
                    rows: 2,
                    placeholder: t("reports.template_report.comment_placeholder") %>
  </div>

  <button type="button"
          class="inline-flex items-center self-start rounded-lg px-3 py-1.5 text-sm text-red-500 hover:bg-red-50 dark:hover:bg-red-900/40"
          data-action="nested-form#remove">
    X
  </button>
</div>
