<% image = report.new_record? ? nil : report.images[n] %>
<div class="mt-3 rounded-lg border border-default p-2">
  <h4 class="mb-2 mt-4 text-base font-semibold text-heading"><%= title %></h4>
  <%= render "shared/file_upload", file: image,
                                    form: f,
                                    resize: [nil, 250],
                                    file_field: :images, new_label: "Imágen",
                                    accepted_formats: "image/jpeg, image/jpg, image/png",
                                    multiple: true %>
</div>
